    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — EDITORIAL ROUTING v4\n// REVISAR no longer means \"notes required\". It opens the production review/editor workspace.\n// Notes remain optional and are used only when the user explicitly chooses AI_REVISION later.\n\nconst rows = $input.all().map(i => i.json);\nconst now = new Date().toISOString();\nconst candidates = [];\n\nfor (const r of rows) {\n  const decision = String(r.EDITORIAL_COMMITTED_STATUS || '').trim().toUpperCase();\n  const source = String(r.EDITORIAL_APPROVAL_SOURCE || '').trim().toUpperCase();\n\n  if (!['APROVADO','REVISAR','DESCARTADO'].includes(decision)) continue;\n  if (source !== 'HUMAN_GOOGLE_SHEETS') continue;\n\n  const notes = String(r.EDITORIAL_APPROVAL_NOTES || '').trim();\n  const decisionAt = String(r.EDITORIAL_DECIDED_AT || '').trim();\n  const routedFrom = String(r.ROUTED_FROM_EDITORIAL_AT || '').trim();\n\n  let route_key='', target='', production='', revision='', editorial='', pipeline='';\n  let variantReview='', revisionMode='', productionContract='';\n\n  if (decision === 'APROVADO') {\n    route_key='PRODUCTION_READY';\n    target='PRODUCTION';\n    production='READY';\n    revision='NOT_REQUIRED';\n    editorial='ACTIVE';\n    pipeline='PRODUCTION_READY';\n    variantReview='PENDING';\n    revisionMode='UNDECIDED';\n    productionContract='SM3_PRODUCTION_EDIT_V1';\n  } else if (decision === 'REVISAR') {\n    route_key='EDITOR_REVIEW_READY';\n    target='EDITOR_REVIEW';\n    production='READY_FOR_VARIANTS';\n    revision='EDITOR_REVIEW_READY';\n    editorial='ACTIVE';\n    pipeline='EDITOR_REVIEW_READY';\n    variantReview='PENDING';\n    revisionMode=String(r.REVISION_MODE || '').trim().toUpperCase() || 'UNDECIDED';\n    productionContract='SM3_PRODUCTION_EDIT_V1';\n  } else if (decision === 'DESCARTADO') {\n    route_key='EDITORIAL_CLOSED';\n    target='CLOSED';\n    production='NOT_APPLICABLE';\n    revision='NOT_APPLICABLE';\n    editorial='CLOSED';\n    pipeline='EDITORIAL_DISCARDED';\n    variantReview='';\n    revisionMode='';\n    productionContract='';\n  }\n\n  const routingMismatch =\n    String(r.ROUTING_TARGET || '').trim().toUpperCase() !== target ||\n    String(r.PRODUCTION_STATUS || '').trim().toUpperCase() !== production ||\n    String(r.REVISION_STATUS || '').trim().toUpperCase() !== revision ||\n    String(r.EDITORIAL_STATUS || '').trim().toUpperCase() !== editorial ||\n    String(r.PIPELINE_STATE || '').trim().toUpperCase() !== pipeline ||\n    (decision !== 'DESCARTADO' && String(r.VARIANT_REVIEW_STATUS || '').trim().toUpperCase() !== variantReview) ||\n    (decision !== 'DESCARTADO' && String(r.REVISION_MODE || '').trim().toUpperCase() !== revisionMode) ||\n    (decision !== 'DESCARTADO' && String(r.PRODUCTION_CONTRACT_VERSION || '').trim() !== productionContract);\n\n  const decisionChanged = decisionAt && decisionAt !== routedFrom;\n  if (!decisionChanged && !routingMismatch) continue;\n\n  candidates.push({\n    json:{\n      no_work:false,\n      route_key,\n      ID_CONTEÚDO:r.ID_CONTEÚDO,\n      ID_PROJETO:r.ID_PROJETO,\n      TÍTULO_INTERNO:r.TÍTULO_INTERNO,\n      FORMATO:r.FORMATO,\n      OBJETIVO:r.OBJETIVO,\n      PRIORIDADE:r.PRIORIDADE,\n      BRUTOS_USADOS:r.BRUTOS_USADOS,\n      HOOK:r.HOOK,\n      ROTEIRO:r.ROTEIRO,\n      LEGENDA:r.LEGENDA,\n      CTA:r.CTA,\n      TEMPLATE_ID:r.TEMPLATE_ID,\n      CONTENT_TEMPLATE_ID:r.CONTENT_TEMPLATE_ID || '',\n      COVER_TEMPLATE_ID:r.COVER_TEMPLATE_ID || '',\n      ART_DIRECTION_PROFILE_ID:r.ART_DIRECTION_PROFILE_ID || '',\n      EDITORIAL_COMMITTED_STATUS:decision,\n      EDITORIAL_APPROVAL_NOTES:notes,\n      EDITORIAL_DECIDED_AT:decisionAt,\n\n      ROUTING_STATUS:'ROUTED',\n      ROUTING_VERSION:'SM3_ROUTING_V3_EDITOR_WORKSPACE',\n      ROUTING_DECISION:decision,\n      ROUTING_TARGET:target,\n      ROUTED_AT:now,\n      ROUTING_SOURCE:'HUMAN_EDITORIAL_GATE',\n      ROUTED_FROM_EDITORIAL_AT:decisionAt,\n      PRODUCTION_STATUS:production,\n      REVISION_STATUS:revision,\n      EDITORIAL_STATUS:editorial,\n      PIPELINE_STATE:pipeline,\n      STATE_UPDATED_AT:now,\n      STATE_VERSION:'SM3_STATE_V3',\n\n      VARIANT_REVIEW_STATUS:variantReview,\n      REVISION_MODE:revisionMode,\n      PRODUCTION_CONTRACT_VERSION:productionContract\n    }\n  });\n}\n\nif (candidates.length === 0) {\n  return [{\n    json:{\n      no_work:true,\n      route_key:'NO_WORK',\n      message:'Todas as decisões editoriais já estão roteadas no contrato atual.',\n      checked_at:now\n    }\n  }];\n}\n\nreturn candidates;"
      },
