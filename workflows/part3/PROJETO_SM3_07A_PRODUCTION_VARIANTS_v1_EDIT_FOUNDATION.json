      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — PRODUCTION VARIANT QUEUE v1\n// Builds editable production packages for both APPROVED and REVIEW items.\n// REVISAR no longer requires notes; it opens an editor/variant workspace.\n\nconst contentRows = $('READ — PRODUCTION CONTENT').all().map(i => i.json);\nconst mediaRows = $('READ — PRODUCTION MEDIA').all().map(i => i.json);\nconst assetsRows = $('READ — IDENTITY ASSETS').all().map(i => i.json);\nconst rulesRows = $('READ — IDENTITY RULES').all().map(i => i.json);\nconst engineRows = $('READ — COMPOSITION ENGINE').all().map(i => i.json);\nconst templateRows = $input.all().map(i => i.json);\n\nconst mediaById = new Map(mediaRows.filter(r=>String(r.ID_MIDIA||'').trim()).map(r=>[String(r.ID_MIDIA).trim(),r]));\nconst templateById = new Map(templateRows.filter(r=>String(r.ID_TEMPLATE||'').trim()).map(r=>[String(r.ID_TEMPLATE).trim(),r]));\nconst profileById = new Map(engineRows.filter(r=>String(r.ID_PERFIL||'').trim()).map(r=>[String(r.ID_PERFIL).trim(),r]));\n\nconst activeRules = rulesRows\n  .filter(r=>String(r.STATUS||'').trim().toUpperCase()==='ATIVA')\n  .map(r=>({id:r.ID_REGRA,scope:r.ESCOPO,rule:r.REGRA,priority:r.PRIORIDADE,application:r.APLICAÇÃO,exception:r.EXCEÇÃO||''}));\n\nconst availableAssets = assetsRows\n  .filter(r=>['ATIVO','OFICIAL','MUTÁVEL'].includes(String(r.STATUS||'').trim().toUpperCase()))\n  .map(r=>({id:r.ID_ATIVO,category:r.CATEGORIA,name:r.NOME,type:r.TIPO,status:r.STATUS,authority:r.AUTORIDADE,function:r['FUNÇÃO']||'',recommended_use:r.USO_RECOMENDADO||'',restrictions:r['RESTRIÇÕES']||'',drive_id:r.ID_DRIVE||'',variant:r.VARIANTE||'',priority:r.PRIORIDADE||''}));\n\nfunction mediaIds(value){\n  return [...new Set((String(value||'').match(/M\\d{4}/g)||[]))];\n}\nfunction kind(tipo){\n  const t=String(tipo||'').normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toUpperCase();\n  return t.includes('VIDEO') ? 'video' : 'image';\n}\nfunction target(format){\n  const f=String(format||'').trim().toUpperCase();\n  if(f==='REEL'||f==='STORY') return {width:1080,height:1920,fps:30,aspect_ratio:'9:16',container:f==='REEL'?'mp4':'mixed'};\n  if(f==='CARROSSEL'||f==='FOTO') return {width:1080,height:1350,fps:null,aspect_ratio:'4:5',container:'jpg'};\n  return null;\n}\n\nconst out=[];\nfor(const c of contentRows){\n  const decision=String(c.EDITORIAL_COMMITTED_STATUS||'').trim().toUpperCase();\n  const targetRoute=String(c.ROUTING_TARGET||'').trim().toUpperCase();\n  const prod=String(c.PRODUCTION_STATUS||'').trim().toUpperCase();\n  const editorial=String(c.EDITORIAL_STATUS||'').trim().toUpperCase();\n  const review=String(c.VARIANT_REVIEW_STATUS||'').trim().toUpperCase();\n  const existingSet=String(c.VARIANT_SET_ID||'').trim();\n\n  const approved = decision==='APROVADO' && targetRoute==='PRODUCTION' && prod==='READY';\n  const reviewReady = decision==='REVISAR' && targetRoute==='EDITOR_REVIEW' && prod==='READY_FOR_VARIANTS';\n  if(!(approved||reviewReady)) continue;\n  if(editorial!=='ACTIVE') continue;\n\n  // Idempotency: only regenerate when explicitly requested.\n  if(existingSet && review!=='REGENERATE') continue;\n\n  const ids=mediaIds(c.BRUTOS_USADOS);\n  const targetSpec=target(c.FORMATO);\n  const blocking=[];\n  if(!targetSpec) blocking.push(`UNSUPPORTED_FORMAT:${c.FORMATO}`);\n  if(!ids.length) blocking.push('NO_SOURCE_MEDIA');\n\n  const media=[];\n  for(const id of ids){\n    const m=mediaById.get(id);\n    if(!m){ blocking.push(`MISSING_MEDIA:${id}`); continue; }\n    if(String(m.STORAGE_STATUS||'').trim().toUpperCase()!=='ONLINE') blocking.push(`MEDIA_OFFLINE:${id}`);\n    media.push({\n      media_id:id,\n      kind:kind(m.TIPO),\n      file_name:m.ARQUIVO||'',\n      drive_file_id:m.DRIVE_FILE_ID||'',\n      link_drive:m.LINK_DRIVE||'',\n      best_moment:m.MELHOR_TRECHO||'',\n      visual_summary:m['CONTEÚDO_VISUAL']||'',\n      analysis_stage:m.ANALYSIS_STAGE||'',\n      shot_type:m.SHOT_TYPE||'',\n      body_region:m.BODY_REGION||'',\n      body_subregion:m.BODY_SUBREGION||'',\n      view_angle:m.VIEW_ANGLE||'',\n      body_pose:m.BODY_POSE||'',\n      tattoo_orientation:m.TATTOO_ORIENTATION||'',\n      tattoo_style_tags:m.TATTOO_STYLE_TAGS||'',\n      tattoo_subject_primary:m.TATTOO_SUBJECT_PRIMARY||'',\n      tattoo_subject_tags:m.TATTOO_SUBJECT_TAGS||'',\n      tattoo_stage_structural:m.TATTOO_STAGE_STRUCTURAL||'',\n      tattoo_coverage:m.TATTOO_COVERAGE||'',\n      composition_shape:m.COMPOSITION_SHAPE||'',\n      focal_description:m.FOCAL_DESCRIPTION||'',\n      focus_point_norm:m.FOCUS_POINT_NORM||'',\n      tattoo_bbox_norm:m.TATTOO_BBOX_NORM||'',\n      crop_guidance_json:m.CROP_GUIDANCE_JSON||'',\n      format_fit_json:m.FORMAT_FIT_JSON||'',\n      best_formats:m.BEST_FORMATS||'',\n      structural_confidence:Number(m.STRUCTURAL_CONFIDENCE||0)||null\n    });\n  }\n\n  const tpl=templateById.get(String(c.TEMPLATE_ID||c.CONTENT_TEMPLATE_ID||'').trim())||null;\n  const profile=profileById.get(String(c.ART_DIRECTION_PROFILE_ID||'').trim())||null;\n  if(!tpl) blocking.push('TEMPLATE_NOT_FOUND');\n  if(!profile) blocking.push('ART_DIRECTION_PROFILE_NOT_FOUND');\n\n  out.push({json:{\n    no_work:false,\n    route_key:blocking.length?'BLOCKED':'PLAN',\n    blocking_reasons:blocking,\n    project_id:c.ID_PROJETO,\n    content_id:c.ID_CONTEÚDO,\n    format:c.FORMATO,\n    title:c.TÍTULO_INTERNO||'',\n    objective:c.OBJETIVO||'',\n    hook:c.HOOK||'',\n    script:c.ROTEIRO||'',\n    caption:c.LEGENDA||'',\n    cta:c.CTA||'',\n    template_id:String(c.TEMPLATE_ID||c.CONTENT_TEMPLATE_ID||''),\n    art_direction_profile_id:String(c.ART_DIRECTION_PROFILE_ID||''),\n    editorial_decision:decision,\n    editorial_notes:String(c.EDITORIAL_APPROVAL_NOTES||''),\n    revision_mode:String(c.REVISION_MODE||'UNDECIDED').trim().toUpperCase()||'UNDECIDED',\n    variant_count:3,\n    render_target:targetSpec||{},\n    source_media:media,\n    identity_rules:activeRules,\n    identity_assets:availableAssets,\n    persist:true,\n    production_contract_version:'SM3_PRODUCTION_EDIT_V1',\n    queued_at:new Date().toISOString()\n  }});\n}\n\nif(!out.length){\n  return [{json:{no_work:true,route_key:'NO_WORK',message:'Nenhum conteúdo requer novo conjunto de variantes.',checked_at:new Date().toISOString()}}];\n}\nreturn out;"
      },
