      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst byStatus = {};\n\nfor (const x of items) {\n  const s = String(x.APPROVAL_COMMITTED_STATUS || x.STATUS_APROVAÇÃO || 'UNKNOWN').toUpperCase();\n  byStatus[s] = (byStatus[s] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    workflow: 'PROJETO_SM3_05_APPROVAL',\n    status: 'HUMAN_DECISIONS_COMMITTED',\n    decisions_committed: items.length,\n    by_status: byStatus,\n    content_ids: items.map(x => x.ID_CONTEÚDO),\n    completed_at: new Date().toISOString()\n  }\n}];"
      },
