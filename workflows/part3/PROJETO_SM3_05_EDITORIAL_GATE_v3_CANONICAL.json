    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now = new Date().toISOString();\n\nreturn $input.all().map(i => {\n  const x = i.json;\n  const decision = String(x.EDITORIAL_APPROVAL_STATUS || '').trim().toUpperCase();\n\n  if (!['APROVADO','REVISAR','DESCARTADO'].includes(decision)) {\n    throw new Error(`EDITORIAL_GATE_BLOCK: invalid decision ${decision}`);\n  }\n  if (!String(x.ID_CONTEÚDO || '').trim()) {\n    throw new Error('EDITORIAL_GATE_BLOCK: missing ID_CONTEÚDO');\n  }\n\n  const pipeline =\n    decision === 'APROVADO' ? 'EDITORIAL_APPROVED' :\n    decision === 'REVISAR' ? 'EDITORIAL_REVISION' :\n    'EDITORIAL_DISCARDED';\n\n  return {\n    json:{\n      ID_CONTEÚDO:x.ID_CONTEÚDO,\n      EDITORIAL_APPROVAL_STATUS:decision,\n      EDITORIAL_COMMITTED_STATUS:decision,\n      EDITORIAL_APPROVAL_NOTES:x.EDITORIAL_APPROVAL_NOTES || '',\n      EDITORIAL_DECIDED_AT:now,\n      EDITORIAL_APPROVAL_VERSION:'SM3_EDITORIAL_GATE_V2',\n      EDITORIAL_APPROVAL_SOURCE:'HUMAN_GOOGLE_SHEETS',\n      PIPELINE_STATE:pipeline,\n      STATE_UPDATED_AT:now,\n      STATE_VERSION:'SM3_STATE_V2'\n    }\n  };\n});"
      },
