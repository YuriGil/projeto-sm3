    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contents = $('READ — CONTENT VARIANT STATE').all().map(i => i.json);\nconst mediaRows = $('READ — MEDIA REGISTRY').all().map(i => i.json);\n\nconst eligible = contents.filter(c => {\n  const review = String(c.VARIANT_REVIEW_STATUS || '').trim().toUpperCase();\n  const setId = String(c.VARIANT_SET_ID || '').trim();\n  const contract = String(c.PRODUCTION_CONTRACT_VERSION || '').trim();\n  const render = String(c.RENDER_STATUS || '').trim().toUpperCase();\n  const prod = String(c.PRODUCTION_STATUS || '').trim().toUpperCase();\n  return review === 'PENDING' && setId && contract === 'SM3_PRODUCTION_EDIT_V1' &&\n         render === 'VARIANTS_PLANNED' && ['READY','READY_FOR_VARIANTS'].includes(prod);\n});\n\nif (!eligible.length) {\n  return [{json:{route_key:'NO_WORK', status:'NO_VARIANT_PREVIEWS_PENDING'}}];\n}\n\nconst mediaById = new Map(mediaRows.map(m => [String(m.ID_MIDIA || '').trim(), m]));\nconst needed = new Map();\nconst blocked = [];\n\nfor (const c of eligible) {\n  const ids = [...new Set(String(c.BRUTOS_USADOS || '').match(/M\\d{4,}/g) || [])];\n  if (!ids.length) {\n    blocked.push({content_id:c.ID_CONTEÚDO, reason:'NO_MEDIA_IDS'});\n    continue;\n  }\n  for (const mid of ids) {\n    const m = mediaById.get(mid);\n    if (!m || !String(m.DRIVE_FILE_ID || '').trim()) {\n      blocked.push({content_id:c.ID_CONTEÚDO, media_id:mid, reason:'MEDIA_REGISTRY_OR_DRIVE_ID_MISSING'});\n      continue;\n    }\n    const safeName = String(m.ARQUIVO || `${mid}.bin`).replace(/[^A-Za-z0-9._-]+/g,'_').slice(-120);\n    const key = mid;\n    if (!needed.has(key)) {\n      needed.set(key, {\n        route_key:'DOWNLOAD',\n        ID_MIDIA:mid,\n        DRIVE_FILE_ID:String(m.DRIVE_FILE_ID),\n        ARQUIVO:String(m.ARQUIVO || safeName),\n        kind:(() => {\n          const tipo = String(m.TIPO || '')\n            .normalize('NFD')\n            .replace(/[\\u0300-\\u036f]/g, '')\n            .trim()\n            .toUpperCase();\n          const mime = String(m.MIME_TYPE || '').trim().toLowerCase();\n          const name = String(m.ARQUIVO || '').trim().toLowerCase();\n          const ext = (name.match(/\\.([a-z0-9]+)$/) || [,''])[1];\n          const videoExt = new Set(['mp4','mov','m4v','avi','mkv','webm','3gp','3g2','mts','m2ts','mpeg','mpg','wmv','flv','ts']);\n          const imageExt = new Set(['jpg','jpeg','png','webp','bmp','tif','tiff','heic','heif','avif','gif']);\n          if (mime.startsWith('video/') || tipo === 'VIDEO' || videoExt.has(ext)) return 'video';\n          if (mime.startsWith('image/') || ['FOTO','IMAGEM','IMAGE'].includes(tipo) || imageExt.has(ext)) return 'image';\n          // Fail-safe fallback: the worker independently auto-detects the file again.\n          return videoExt.has(ext) ? 'video' : 'image';\n        })(),\n        worker_source_path:`/data/media/inbox/n8n_temp/variant_${mid}_${safeName}`,\n        content_ids:[]\n      });\n    }\n    needed.get(key).content_ids.push(String(c.ID_CONTEÚDO));\n  }\n}\n\nif (blocked.length) {\n  // Fail closed: do not render a partial content set silently.\n  return [{json:{route_key:'BLOCKED', status:'VARIANT_PREVIEW_BLOCKED', blocked}}];\n}\n\nreturn [...needed.values()].map(x => ({json:x}));"
      },
