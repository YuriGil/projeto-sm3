    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const written = $input.all().map(i => i.json);\nconst contents = $('READ — CONTENT VARIANT STATE').all().map(i => i.json);\nconst sourceMap = new Map(written.map(x => [String(x.ID_MIDIA), x]));\n\nconst eligible = contents.filter(c => {\n  const review = String(c.VARIANT_REVIEW_STATUS || '').trim().toUpperCase();\n  const setId = String(c.VARIANT_SET_ID || '').trim();\n  const render = String(c.RENDER_STATUS || '').trim().toUpperCase();\n  const prod = String(c.PRODUCTION_STATUS || '').trim().toUpperCase();\n  return review === 'PENDING' && setId && render === 'VARIANTS_PLANNED' && ['READY','READY_FOR_VARIANTS'].includes(prod);\n});\n\nreturn eligible.map(c => {\n  const ids = [...new Set(String(c.BRUTOS_USADOS || '').match(/M\\d{4,}/g) || [])];\n  const sources = ids.map(mid => sourceMap.get(mid)).filter(Boolean).map(s => ({\n    media_id:String(s.ID_MIDIA),\n    kind:s.kind,\n    source_path:s.worker_source_path,\n    file_name:s.ARQUIVO\n  }));\n  if (sources.length !== ids.length) throw new Error(`PREVIEW_JOB_SOURCE_MISMATCH:${c.ID_CONTEÚDO}`);\n  return {json:{\n    project_id:String(c.ID_PROJETO),\n    content_id:String(c.ID_CONTEÚDO),\n    variant_set_id:String(c.VARIANT_SET_ID),\n    format:String(c.FORMATO || ''),\n    source_media:sources,\n    fps:24,\n    max_seconds:12,\n    delete_sources_after:false,\n    force:false\n  }};\n});"
      },
