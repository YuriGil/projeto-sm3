        "jsCode": "const updated = $input.all().map(i => i.json);\nconst rendered = $('BUILD — PREVIEW STATE WRITE').all().map(i => i.json);\nreturn [{json:{\n  status:'VARIANT_PREVIEWS_READY',\n  contents_updated:updated.length,\n  content_ids:updated.map(x=>x.ID_CONTEÚDO),\n  preview_counts:Object.fromEntries(rendered.map(x=>[x.ID_CONTEÚDO,x.preview_count])),\n  manifests:Object.fromEntries(rendered.map(x=>[x.ID_CONTEÚDO,x.preview_manifest_path])),\n  reused_existing_count:rendered.filter(x=>x.reused_existing===true).length,\n  completed_at:new Date().toISOString()\n}}];"
