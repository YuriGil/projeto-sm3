        "jsCode": "const x = $json;\nif (!x.ok) throw new Error('VARIANT_PREVIEW_RENDER_FAILED');\nif (!Array.isArray(x.previews) || x.previews.length < 1) throw new Error('VARIANT_PREVIEW_EMPTY');\nreturn {json:{\n  ID_CONTEÚDO:x.content_id,\n  VARIANT_REVIEW_STATUS:'PREVIEW_READY',\n  RENDER_STATUS:'VARIANT_PREVIEWS_READY',\n  PIPELINE_STATE:'VARIANT_REVIEW_READY',\n  STATE_UPDATED_AT:new Date().toISOString(),\n  STATE_VERSION:'SM3_STATE_V4',\n  preview_contract_version:x.preview_contract_version,\n  variant_set_id:x.variant_set_id,\n  preview_count:x.previews.length,\n  preview_manifest_path:x.manifest_path,\n  previews:x.previews,\n  reused_existing:Boolean(x.reused_existing)\n}};"
