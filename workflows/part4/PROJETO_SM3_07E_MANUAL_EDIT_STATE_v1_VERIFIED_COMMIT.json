      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$input.all().map(x=>x.json),text=x=>String(x??'').trim(),upper=x=>text(x).toUpperCase();\nconst counts=new Map();for(const row of rows){const k=text(row.ID_CONTEÚDO);if(k)counts.set(k,(counts.get(k)||0)+1)}\nconst work=[],errors=[];\nfor(const row of rows){const session=text(row.EDIT_SESSION_ID),pipeline=upper(row.PIPELINE_STATE),review=upper(row.VARIANT_REVIEW_STATUS);\nif(!session&&pipeline!=='EDIT_SESSION_READY')continue;\nconst id=text(row.ID_CONTEÚDO),project=text(row.ID_PROJETO),status=upper(row.EDIT_SESSION_STATUS),variant=upper(row.SELECTED_VARIANT_ID),setId=text(row.VARIANT_SET_ID),problem=[];\nif(counts.get(id)!==1)problem.push('CONTENT_NOT_UNIQUE');if(!project)problem.push('PROJECT_EMPTY');\nif(!/^ES_[A-Za-z0-9_-]+$/.test(session))problem.push('SESSION_INVALID');\nif(!/^VS_[A-Za-z0-9_-]+$/.test(setId))problem.push('VARIANT_SET_INVALID');\nif(!/^V\\d{2}$/.test(variant))problem.push('VARIANT_INVALID');\nif(pipeline!=='EDIT_SESSION_READY'||review!=='OPEN_EDITOR')problem.push('PIPELINE_INVALID');\nif(!['OPEN','SAVED'].includes(status))problem.push('CONTROL_STATUS_INVALID');\nif(text(row.EDIT_RECIPE_VERSION)!=='SM3_EDIT_RECIPE_V1'||text(row.PRODUCTION_CONTRACT_VERSION)!=='SM3_PRODUCTION_EDIT_V1'||text(row.STATE_VERSION)!=='SM3_STATE_V5')problem.push('CONTRACT_INVALID');\nif(problem.length){errors.push({content_id:id,problems:problem});continue}\nwork.push({route:'CHECK',project_id:project,content_id:id,edit_session_id:session,variant_set_id:setId,base_variant_id:variant,sheet_status:status})}\nif(errors.length)throw new Error('SM3_07E_CONTROL_STATE_BLOCKED:'+JSON.stringify(errors));\nif(!work.length)return [{json:{route:'NO_WORK',status:'NO_EDIT_SESSION_TO_RECONCILE'}}];\nreturn work.map(x=>({json:x}));"
      }
    },
