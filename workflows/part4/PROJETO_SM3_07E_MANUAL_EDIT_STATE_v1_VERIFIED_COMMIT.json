        "jsCode": "const h=$json;const errors=[];\nif(h.ok!==true||h.service!=='sm3-media-worker')errors.push('service');\nif(h.version!=='2.5.0')errors.push('version');\nif(h.production_edit_contract!=='SM3_PRODUCTION_EDIT_V1')errors.push('production_contract');\nif(h.editor_workspace_contract!=='SM3_EDITOR_WORKSPACE_V1')errors.push('workspace_contract');\nif(h.edit_session_save_safe!==true||h.edit_session_save_contract!=='SM3_EDIT_SAVE_V1')errors.push('save_contract');\nif(errors.length)throw new Error('SM3_07E_WORKER_CONTRACT:'+errors.join(','));\nreturn {json:{health:'SM3_07E_WORKER_VERIFIED'}};"
