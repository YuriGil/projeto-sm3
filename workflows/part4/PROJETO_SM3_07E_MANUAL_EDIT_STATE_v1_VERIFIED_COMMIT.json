      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const w=$json;\nconst row=$('BUILD — EDIT SESSION QUEUE').all().map(x=>x.json).find(x=>x.edit_session_id===w.edit_session_id);\nif(!row)throw new Error('SM3_07E_ROW_NOT_FOUND');\nif(w.ok!==true||w.version!=='2.5.0'||w.workspace_contract_version!=='SM3_EDITOR_WORKSPACE_V1'||w.save_contract_version!=='SM3_EDIT_SAVE_V1')throw new Error('SM3_07E_WORKSPACE_CONTRACT');\nfor(const key of ['project_id','content_id','edit_session_id','variant_set_id','base_variant_id'])if(w[key]!==row[key])throw new Error('SM3_07E_WORKSPACE_MISMATCH:'+key);\nif(w.preview?.verified!==true||!(/^[a-f0-9]{64}$/.test(String(w.preview?.sha256||'')))||!(/^[a-f0-9]{64}$/.test(String(w.state_etag||''))))throw new Error('SM3_07E_PREVIEW_OR_ETAG');\nif(w.status==='OPEN'&&row.sheet_status==='OPEN')return {json:{route:'NO_WRITE',content_id:w.content_id,reason:'SESSION_STILL_OPEN'}};\nif(w.status==='SAVED'&&Number(w.current_revision)>=2&&row.sheet_status==='SAVED')return {json:{route:'NO_WRITE',content_id:w.content_id,reason:'ALREADY_RECONCILED'}};\nif(w.status==='SAVED'&&Number(w.current_revision)>=2&&row.sheet_status==='OPEN')return {json:{route:'WRITE',ID_CONTEÚDO:w.content_id,EDIT_SESSION_STATUS:'SAVED',REVISION_MODE:'MANUAL_EDIT',PIPELINE_STATE:'EDIT_SESSION_READY',STATE_VERSION:'SM3_STATE_V5',STATE_UPDATED_AT:new Date().toISOString(),edit_session_id:w.edit_session_id,current_revision:w.current_revision,state_etag:w.state_etag}};\nthrow new Error('SM3_07E_SESSION_CONTROL_CONFLICT:'+w.content_id+':'+w.status+':'+row.sheet_status);"
      }
    },
