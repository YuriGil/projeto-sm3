    {
      "name": "BUILD — EDIT SESSION QUEUE",
      "id": "482aa261-2495-42df-85f0-908fe05ed7a9",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
