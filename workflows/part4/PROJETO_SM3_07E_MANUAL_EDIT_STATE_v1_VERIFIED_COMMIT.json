        "jsCode": "const rows=$input.all().map(i=>i.json),expected=$('ASSERT — SAVED REVISION').all().map(i=>i.json).filter(x=>x.route==='WRITE');\nconst counts=new Map();for(const row of rows){const id=String(row.ID_CONTEÚDO||'');counts.set(id,(counts.get(id)||0)+1)}\nfor(const e of expected){const row=rows.find(r=>String(r.ID_CONTEÚDO||'')===e.ID_CONTEÚDO);\nif(!row||counts.get(e.ID_CONTEÚDO)!==1)throw new Error('SM3_07E_COMMITTED_ROW_NOT_UNIQUE:'+e.ID_CONTEÚDO);\nfor(const [key,value] of Object.entries({EDIT_SESSION_STATUS:'SAVED',REVISION_MODE:'MANUAL_EDIT',PIPELINE_STATE:'EDIT_SESSION_READY',STATE_VERSION:'SM3_STATE_V5',EDIT_SESSION_ID:e.edit_session_id}))if(String(row[key]||'')!==value)throw new Error('SM3_07E_PERSISTENCE_MISMATCH:'+e.ID_CONTEÚDO+':'+key);\nif(!String(row.STATE_UPDATED_AT||''))throw new Error('SM3_07E_TIMESTAMP_MISSING:'+e.ID_CONTEÚDO)}\nreturn [{json:{status:'MANUAL_EDIT_CONTROL_COMMITTED',committed_count:expected.length,committed:expected.map(e=>({content_id:e.ID_CONTEÚDO,edit_session_id:e.edit_session_id,current_revision:e.current_revision,state_etag:e.state_etag}))}}];"
