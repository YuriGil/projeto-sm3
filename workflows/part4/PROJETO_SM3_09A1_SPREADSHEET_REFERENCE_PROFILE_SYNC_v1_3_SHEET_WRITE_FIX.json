        "jsCode": "\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  if(r.ok!==true||r.contract_version!=='SM3_REFERENCE_PROFILE_HISTORY_V1')\n    throw new Error('SM3_09A1_HISTORY_BACKFILL_CONTRACT_INVALID');\n  for(const h of (r.history||[])){\n    if(!h||h.contract_version!=='SM3_REFERENCE_PROFILE_HISTORY_V1')\n      throw new Error('SM3_09A1_HISTORY_BACKFILL_RECORD_INVALID');\n    if(!/^RPH_[a-f0-9]{32}$/.test(String(h.preference_snapshot_id||''))||\n       !/^RP_[a-f0-9]{32}$/.test(String(h.reference_profile_id||''))||\n       !/^[a-f0-9]{64}$/.test(String(h.snapshot_sha256||'')))\n      throw new Error('SM3_09A1_HISTORY_BACKFILL_HASH_OR_ID_INVALID');\n    out.push({json:{historyRow:{\n      PREFERENCE_SNAPSHOT_ID:h.preference_snapshot_id,\n      REFERENCE_PROFILE_ID:h.reference_profile_id,\n      NETWORK:h.network,\n      HANDLE:h.handle,\n      PROFILE_URL:h.profile_url||'',\n      LABEL:h.label||'',\n      USER_INTEREST:(h.user_interest||[]).join(', '),\n      STYLE_NOTES:h.style_notes||'',\n      DISLIKE_NOTES:h.dislike_notes||'',\n      HUMAN_PRIORITY:h.human_priority,\n      ACTIVE:!!h.active,\n      PREFERENCE_VERSION:h.preference_version,\n      VALID_FROM:h.valid_from||'',\n      VALID_TO:h.valid_to||'',\n      CHANGE_REASON:h.change_reason||'',\n      SOURCE:h.source||'',\n      SNAPSHOT_SHA256:h.snapshot_sha256,\n      CAPTURED_AT:h.captured_at||''\n    }}});\n  }\n}\nreturn out;\n"
