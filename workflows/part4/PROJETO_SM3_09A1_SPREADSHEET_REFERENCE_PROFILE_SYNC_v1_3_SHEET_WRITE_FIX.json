    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst norm=x=>String(x??'').trim();\nconst bool=x=>{if(typeof x==='boolean')return x;const s=norm(x).toUpperCase();return ['TRUE','1','YES','SIM','Y'].includes(s)};\nconst interests=x=>[...new Set(norm(x).split(/[;,\\n]+/).map(v=>v.trim().toUpperCase()).filter(Boolean))].sort();\nconst cleanHandle=x=>norm(x).replace(/^@/,'').trim().toLowerCase();\n\nconst parseProfileUrl=(raw)=>{\n  let s=norm(raw);\n  if(!s)return null;\n\n  // n8n Code sandbox may not expose the global URL constructor.\n  // Parse these two known social profile URL formats explicitly instead.\n  s=s.replace(/\\s+/g,'');\n  if(!/^https?:\\/\\//i.test(s)) s='https://'+s;\n\n  // Strip query/hash before extracting the path. This accepts Instagram share\n  // links such as ?stkn=... without treating the token as part of the handle.\n  const noFragment=s.split('#')[0];\n  const noQuery=noFragment.split('?')[0];\n\n  let m=noQuery.match(/^https?:\\/\\/(?:www\\.)?instagram\\.com\\/([^\\/?#]+)\\/?$/i);\n  if(m){\n    const first=String(m[1]||'').replace(/^@/,'').toLowerCase();\n    const reserved=new Set(['p','reel','reels','stories','explore','accounts','direct','tv']);\n    if(!first)throw new Error('SM3_09A1_INSTAGRAM_PROFILE_URL_MISSING_HANDLE:'+raw);\n    if(reserved.has(first))throw new Error('SM3_09A1_EXPECTED_PROFILE_URL_GOT_CONTENT_URL:'+raw);\n    if(!/^[a-z0-9._]{1,64}$/.test(first))throw new Error('SM3_09A1_HANDLE_INVALID_FROM_URL:'+first);\n    return {network:'instagram',handle:first,canonicalUrl:`https://www.instagram.com/${first}/`};\n  }\n\n  m=noQuery.match(/^https?:\\/\\/(?:www\\.)?tiktok\\.com\\/@([^\\/?#]+)\\/?$/i);\n  if(m){\n    const first=String(m[1]||'').toLowerCase();\n    if(!first)throw new Error('SM3_09A1_TIKTOK_PROFILE_URL_MISSING_HANDLE:'+raw);\n    if(!/^[a-z0-9._]{1,64}$/.test(first))throw new Error('SM3_09A1_HANDLE_INVALID_FROM_URL:'+first);\n    return {network:'tiktok',handle:first,canonicalUrl:`https://www.tiktok.com/@${first}`};\n  }\n\n  // Diagnose common accidental content links more clearly.\n  if(/^https?:\\/\\/(?:www\\.)?instagram\\.com\\/(?:p|reel|reels|stories|tv)\\//i.test(noQuery)){\n    throw new Error('SM3_09A1_EXPECTED_PROFILE_URL_GOT_CONTENT_URL:'+raw);\n  }\n\n  throw new Error('SM3_09A1_PROFILE_URL_INVALID:'+raw);\n};\n\nconst out=[]; const handles=new Set(), ids=new Set();\nfor(const r of rows){\n  const rid=norm(r.REFERENCE_PROFILE_ID);\n  const rawUrl=norm(r.PROFILE_URL);\n  const rawNetwork=norm(r.NETWORK).toLowerCase();\n  const rawHandle=cleanHandle(r.HANDLE);\n\n  // Ignore preformatted empty rows and draft rows containing only NETWORK.\n  if(!rid&&!rawUrl&&!rawHandle)continue;\n\n  const parsed=rawUrl?parseProfileUrl(rawUrl):null;\n  const network=rawNetwork||(parsed?.network||'');\n  const handle=rawHandle||(parsed?.handle||'');\n\n  if(!network||!handle)throw new Error('SM3_09A1_PROFILE_ROW_INCOMPLETE:'+handle+':'+rid+':'+rawUrl);\n  if(!['instagram','tiktok'].includes(network))throw new Error('SM3_09A1_NETWORK_INVALID:'+network);\n  if(parsed&&parsed.network!==network)throw new Error('SM3_09A1_NETWORK_URL_MISMATCH:'+network+':'+parsed.network+':'+rawUrl);\n  if(parsed&&rawHandle&&parsed.handle!==rawHandle)throw new Error('SM3_09A1_HANDLE_URL_MISMATCH:'+rawHandle+':'+parsed.handle+':'+rawUrl);\n\n  const hk=network+'|'+handle;\n  if(handles.has(hk))throw new Error('SM3_09A1_DUPLICATE_HANDLE:'+hk);\n  handles.add(hk);\n\n  if(rid){\n    if(ids.has(rid))throw new Error('SM3_09A1_DUPLICATE_PROFILE_ID:'+rid);\n    ids.add(rid);\n  }\n\n  const pRaw=norm(r.HUMAN_PRIORITY);\n  const priority=pRaw===''?50:Number(pRaw);\n  if(!Number.isInteger(priority)||priority<0||priority>100)throw new Error('SM3_09A1_PRIORITY_INVALID:'+handle);\n\n  const verRaw=norm(r.PREFERENCE_VERSION);\n  const expected=rid?(verRaw===''?null:Number(verRaw)):null;\n  if(rid&&(expected===null||!Number.isInteger(expected)||expected<1))\n    throw new Error('SM3_09A1_PREFERENCE_VERSION_INVALID:'+handle);\n\n  const matchMode=rid?'ID':(rawUrl?'URL':'HANDLE');\n\n  out.push({json:{\n    reference_profile_id:rid||null,\n    network,\n    handle,\n    profile_url:(parsed?.canonicalUrl||rawUrl||null),\n    label:norm(r.LABEL)||null,\n    user_interest:interests(r.USER_INTEREST),\n    style_notes:norm(r.STYLE_NOTES),\n    dislike_notes:norm(r.DISLIKE_NOTES),\n    source:(norm(r.SOURCE)||'HUMAN').toUpperCase(),\n    active:bool(r.ACTIVE),\n    human_priority:priority,\n    notes:norm(r.NOTES),\n    expected_preference_version:expected,\n    change_reason:'SPREADSHEET_SYNC',\n    human_reviewed_at:null,\n    client_context:{\n      had_profile_id:!!rid,\n      sheet_reference_profile_id:rid||null,\n      sheet_network:network,\n      sheet_match_handle:rawHandle||handle,\n      sheet_match_url:rawUrl||null,\n      sheet_match_mode:matchMode,\n      derived_handle:!rawHandle,\n      derived_network:!rawNetwork,\n      canonical_profile_url:(parsed?.canonicalUrl||rawUrl||null)\n    }\n  }});\n}\n\nif(!out.length)return [{json:{route:'NO_WORK'}}];\nreturn out.map(x=>({json:{route:'SYNC',...x.json}}));\n"
