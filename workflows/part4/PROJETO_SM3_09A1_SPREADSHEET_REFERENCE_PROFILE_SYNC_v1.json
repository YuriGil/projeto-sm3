    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst norm=x=>String(x??'').trim();\nconst bool=x=>{if(typeof x==='boolean')return x;const s=norm(x).toUpperCase();return ['TRUE','1','YES','SIM','Y'].includes(s)};\nconst interests=x=>[...new Set(norm(x).split(/[;,\\n]+/).map(v=>v.trim().toUpperCase()).filter(Boolean))].sort();\nconst out=[]; const handles=new Set(), ids=new Set();\nfor(const r of rows){\n  const network=norm(r.NETWORK).toLowerCase(), rawHandle=norm(r.HANDLE), rid=norm(r.REFERENCE_PROFILE_ID);\n  if(!network&&!rawHandle&&!rid)continue;\n  if(!network||!rawHandle)throw new Error('SM3_09A1_PROFILE_ROW_INCOMPLETE:'+rawHandle+':'+rid);\n  if(!['instagram','tiktok'].includes(network))throw new Error('SM3_09A1_NETWORK_INVALID:'+network);\n  const hk=network+'|'+rawHandle.replace(/^@/,'').toLowerCase();\n  if(handles.has(hk))throw new Error('SM3_09A1_DUPLICATE_HANDLE:'+hk); handles.add(hk);\n  if(rid){if(ids.has(rid))throw new Error('SM3_09A1_DUPLICATE_PROFILE_ID:'+rid);ids.add(rid)}\n  const pRaw=norm(r.HUMAN_PRIORITY); const priority=pRaw===''?50:Number(pRaw);\n  if(!Number.isInteger(priority)||priority<0||priority>100)throw new Error('SM3_09A1_PRIORITY_INVALID:'+rawHandle);\n  const verRaw=norm(r.PREFERENCE_VERSION); const expected=rid?(verRaw===''?null:Number(verRaw)):null;\n  if(rid&&(expected===null||!Number.isInteger(expected)||expected<1))throw new Error('SM3_09A1_PREFERENCE_VERSION_INVALID:'+rawHandle);\n  out.push({json:{\n    reference_profile_id:rid||null,network,handle:rawHandle,profile_url:norm(r.PROFILE_URL)||null,label:norm(r.LABEL)||null,\n    user_interest:interests(r.USER_INTEREST),style_notes:norm(r.STYLE_NOTES),dislike_notes:norm(r.DISLIKE_NOTES),\n    source:(norm(r.SOURCE)||'HUMAN').toUpperCase(),active:bool(r.ACTIVE),human_priority:priority,notes:norm(r.NOTES),\n    expected_preference_version:expected,change_reason:'SPREADSHEET_SYNC',human_reviewed_at:null,\n    client_context:{had_profile_id:!!rid,sheet_reference_profile_id:rid||null,sheet_network:network,sheet_match_handle:rawHandle}\n  }});\n}\nif(!out.length)return [{json:{route:'NO_WORK'}}];\nreturn out.map(x=>({json:{route:'SYNC',...x.json}}));\n"
