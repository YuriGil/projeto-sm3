    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst out=[];\nfor(const it of $input.all()){\n const r=it.json,p=r.profile,c=r.client_context||{};\n if(r.ok!==true||r.sync_contract_version!=='SM3_REFERENCE_PROFILE_SYNC_V1'||!p||p.contract_version!=='SM3_REFERENCE_PROFILE_V1'||\n   !/^RP_[a-f0-9]{32}$/.test(String(p.reference_profile_id||''))||!/^[a-f0-9]{64}$/.test(String(p.profile_sha256||''))||\n   !Number.isInteger(Number(p.preference_version))||Number(p.preference_version)<1)\n   throw new Error('SM3_09A1_PROFILE_SYNC_RESULT_INVALID');\n const now=new Date().toISOString();\n const current={\n   REFERENCE_PROFILE_ID:p.reference_profile_id,\n   NETWORK:String(c.sheet_network||p.network),HANDLE:String(c.sheet_match_handle||p.handle),\n   METRICOOL_COMPETITOR_CONFIGURED:!!p.metricool_competitor_configured,\n   PROFILE_SHA256:p.profile_sha256,CREATED_AT:p.created_at,UPDATED_AT:p.updated_at,\n   PREFERENCE_VERSION:p.preference_version,LAST_HUMAN_REVIEW_AT:p.last_human_review_at||'',\n   SYNC_STATUS:'SYNCED',SYNC_MESSAGE:r.change_type,LAST_SYNC_AT:now\n };\n out.push({json:{write_target:c.had_profile_id?'CURRENT_EXISTING':'CURRENT_NEW',currentRow:current}});\n if(r.history_snapshot){\n  const h=r.history_snapshot;\n  if(h.contract_version!=='SM3_REFERENCE_PROFILE_HISTORY_V1'||!/^[a-f0-9]{64}$/.test(String(h.snapshot_sha256||'')))\n    throw new Error('SM3_09A1_HISTORY_RESULT_INVALID');\n  out.push({json:{write_target:'HISTORY',historyRow:{\n    PREFERENCE_SNAPSHOT_ID:h.preference_snapshot_id,REFERENCE_PROFILE_ID:h.reference_profile_id,NETWORK:h.network,HANDLE:h.handle,\n    PROFILE_URL:h.profile_url||'',LABEL:h.label||'',USER_INTEREST:(h.user_interest||[]).join(', '),STYLE_NOTES:h.style_notes||'',DISLIKE_NOTES:h.dislike_notes||'',\n    HUMAN_PRIORITY:h.human_priority,ACTIVE:!!h.active,PREFERENCE_VERSION:h.preference_version,VALID_FROM:h.valid_from||'',VALID_TO:h.valid_to||'',\n    CHANGE_REASON:h.change_reason||'',SOURCE:h.source||'',SNAPSHOT_SHA256:h.snapshot_sha256,CAPTURED_AT:h.captured_at||''\n  }}});\n }\n}\nreturn out;\n"
