    {
      "name": "BUILD — EDIT PREVIEW JOBS",
      "id": "566b83dd-d978-4622-b128-163bce5527af",
      "type": "n8n-nodes-base.code",
      "position": [
        200,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst written=$input.all().map(i=>i.json),contents=$('READ — 04_CONTEUDOS').all().map(i=>i.json),\n  map=new Map(written.map(x=>[String(x.ID_MIDIA),x]));\nconst chosen=contents.filter(c=>String(c.EDIT_SESSION_STATUS||'').trim().toUpperCase()==='SAVED'\n  &&String(c.REVISION_MODE||'').trim().toUpperCase()==='MANUAL_EDIT'\n  &&String(c.PIPELINE_STATE||'').trim().toUpperCase()==='EDIT_SESSION_READY');\nreturn chosen.map(c=>{\n  const ids=[...new Set(String(c.BRUTOS_USADOS||'').match(/M\\d{4,}/g)||[])];\n  const sources=ids.map(id=>map.get(id));\n  if(!ids.length||sources.some(x=>!x))throw new Error('SM3_07F_SOURCE_WRITE_INCOMPLETE:'+c.ID_CONTEÚDO);\n  return {json:{project_id:String(c.ID_PROJETO),content_id:String(c.ID_CONTEÚDO),\n    edit_session_id:String(c.EDIT_SESSION_ID),sheet_render_status:String(c.RENDER_STATUS||'').trim(),\n    source_media:sources.map(x=>({media_id:x.ID_MIDIA,kind:x.kind,source_path:x.worker_source_path,file_name:x.ARQUIVO}))}};\n});\n"
      },
      "typeVersion": 2
    },
