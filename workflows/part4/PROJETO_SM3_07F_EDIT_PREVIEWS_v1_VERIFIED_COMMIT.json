    {
      "name": "ASSERT — REVISION AND SOURCES",
      "id": "85094dc0-e40a-4858-afe2-ea7cdc36e4ac",
      "type": "n8n-nodes-base.code",
      "position": [
        600,
        -160
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst w=$json, job=$('BUILD — EDIT PREVIEW JOBS').all().map(i=>i.json).find(x=>x.edit_session_id===w.edit_session_id);\nif(!job||w.ok!==true||w.status!=='SAVED'||w.current_revision<2||w.read_only!==false||\n   w.workspace_contract_version!=='SM3_EDITOR_WORKSPACE_V1'||\n   !/^[a-f0-9]{64}$/.test(String(w.state_etag||''))||w.project_id!==job.project_id||\n   w.content_id!==job.content_id||w.preview?.verified!==true)\n   throw new Error('SM3_07F_WORKSPACE_REVISION_INVALID:'+String(w.edit_session_id));\nconst required=new Set([...(w.recipe?.media_order||[]),...(w.recipe?.timeline||[]).map(x=>x.media_id)]);\nconst sources=job.source_media.filter(x=>required.has(x.media_id));\nif(!required.size||required.size!==sources.length||new Set(sources.map(x=>x.media_id)).size!==required.size)\n   throw new Error('SM3_07F_RECIPE_SOURCE_MISMATCH:'+w.content_id);\nreturn {json:{...job,source_media:sources,expected_revision:w.current_revision,expected_state_etag:w.state_etag,fps:24,max_seconds:12}};\n"
      },
      "typeVersion": 2
    },
