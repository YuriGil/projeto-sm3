    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now = new Date().toISOString();\n\nreturn $input.all().map(i => {\n  const x = i.json;\n  const decision = String(x.STATUS_APROVAÇÃO || '').trim().toUpperCase();\n\n  if (!['APROVADO', 'REVISAR', 'DESCARTADO'].includes(decision)) {\n    throw new Error(`APPROVAL_COMMIT_BLOCK: invalid decision ${decision}`);\n  }\n  if (!String(x.ID_CONTEÚDO || '').trim()) {\n    throw new Error('APPROVAL_COMMIT_BLOCK: missing ID_CONTEÚDO');\n  }\n\n  return {\n    json: {\n      ID_CONTEÚDO: x.ID_CONTEÚDO,\n      STATUS_APROVAÇÃO: decision,\n      APPROVAL_COMMITTED_STATUS: decision,\n      APPROVAL_NOTES: x.APPROVAL_NOTES || '',\n      APPROVAL_DECIDED_AT: now,\n      APPROVAL_VERSION: 'SM3_APPROVAL_V1',\n      APPROVAL_SOURCE: 'HUMAN_GOOGLE_SHEETS'\n    }\n  };\n});"
      },
