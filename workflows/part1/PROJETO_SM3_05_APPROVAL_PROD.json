    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — HUMAN APPROVAL GATE\n// The human edits STATUS_APROVAÇÃO in 04_CONTEUDOS.\n// This node commits only NEW decisions for AI_PLANNED content.\n// PENDENTE is never treated as a decision.\n\nconst rows = $input.all().map(i => i.json);\nconst allowed = new Set(['APROVADO', 'REVISAR', 'DESCARTADO']);\n\nconst decisions = rows.filter(r => {\n  const planned = String(r.PLAN_STATUS || '').trim().toUpperCase() === 'AI_PLANNED';\n  const current = String(r.STATUS_APROVAÇÃO || '').trim().toUpperCase();\n  const committed = String(r.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase();\n\n  return planned && allowed.has(current) && current !== committed;\n});\n\nif (decisions.length === 0) {\n  return [{\n    json: {\n      no_work: true,\n      route_key: 'NO_WORK',\n      message: 'Nenhuma nova decisão humana precisa ser registrada.',\n      checked_at: new Date().toISOString()\n    }\n  }];\n}\n\nreturn decisions.map((r, index) => ({\n  json: {\n    no_work: false,\n    route_key: 'COMMIT',\n    queue_position: index + 1,\n\n    ID_CONTEÚDO: r.ID_CONTEÚDO,\n    ID_PROJETO: r.ID_PROJETO,\n    TÍTULO_INTERNO: r.TÍTULO_INTERNO,\n    FORMATO: r.FORMATO,\n\n    STATUS_APROVAÇÃO: String(r.STATUS_APROVAÇÃO || '').trim().toUpperCase(),\n    APPROVAL_NOTES: r.APPROVAL_NOTES || '',\n\n    previous_committed_status: r.APPROVAL_COMMITTED_STATUS || '',\n    PLAN_RUN_ID: r.PLAN_RUN_ID || '',\n    CURATION_RUN_ID: r.CURATION_RUN_ID || ''\n  }\n}));"
      },
