    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// MOLOTOV SOCIAL OS — TRIAGE QUEUE CONTRACT\n// Only ANALYSIS_STATUS=QUEUED is eligible.\n// This deliberately ignores legacy rows that merely have TRIAGEM=PENDENTE.\n\nconst rows = $input.all().map(i => i.json);\n\nconst eligible = rows.filter(r =>\n  String(r.ANALYSIS_STATUS || '').trim().toUpperCase() === 'QUEUED' &&\n  String(r.STORAGE_STATUS || '').trim().toUpperCase() === 'ONLINE'\n);\n\nreturn eligible.map(r => {\n  const type = String(r.TIPO || '').trim().toUpperCase();\n\n  const route =\n    type === 'FOTO' ? 'IMAGE_ORIGINAL' :\n    type === 'VÍDEO' || type === 'VIDEO' ? 'VIDEO_PROXY' :\n    'UNSUPPORTED';\n\n  return {\n    json: {\n      ...r,\n      analysis_route: route,\n      analysis_source_planned:\n        route === 'IMAGE_ORIGINAL' ? 'ORIGINAL' :\n        route === 'VIDEO_PROXY' ? 'PROXY' : '',\n      proxy_required: route === 'VIDEO_PROXY',\n      queued_for_analysis_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "4136e57a-f5ba-4084-bcb9-f12d11ad934e",
      "name": "BUILD — TRIAGE QUEUE"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst summary = {\n  queued_total: items.length,\n  image_original: items.filter(x => x.analysis_route === 'IMAGE_ORIGINAL').length,\n  video_proxy: items.filter(x => x.analysis_route === 'VIDEO_PROXY').length,\n  unsupported: items.filter(x => x.analysis_route === 'UNSUPPORTED').length,\n  projects: {}\n};\n\nfor (const x of items) {\n  const p = x.ID_PROJETO || 'NO_PROJECT';\n  summary.projects[p] = (summary.projects[p] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    dry_run: true,\n    summary,\n    queued_ids: items.map(x => x.ID_MIDIA),\n    queue: items\n  }\n}];"
      },
