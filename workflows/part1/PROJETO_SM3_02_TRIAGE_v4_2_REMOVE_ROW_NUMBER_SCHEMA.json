    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ANALYSIS_SOURCE = 'IMAGE_PROXY';\n\nconst now = new Date().toISOString();\nconst items = $input.all().map(i => i.json);\n\nfunction clampScore(v, field) {\n  const n = Number(v);\n  if (!Number.isFinite(n) || n < 0 || n > 100) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: invalid ${field}=${v}`);\n  }\n  return Math.round(n);\n}\n\nconst allowedSelection = new Set(['DESCARTAR', 'ANALISADO', 'SELECIONADO']);\nconst allowedQuality = new Set(['BAIXA', 'MEDIA', 'ALTA']);\n\nreturn items.map(x => {\n  const a = x.analysis || {};\n\n  if (!x.row_number || !x.media_id || !x.project_id) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: missing row/media/project identity`);\n  }\n  if (!x.provider || !x.model) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: missing provider/model for ${x.media_id}`);\n  }\n  if (!allowedSelection.has(String(a.selection || '').toUpperCase())) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: invalid selection for ${x.media_id}`);\n  }\n  if (!allowedQuality.has(String(a.quality || '').toUpperCase())) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: invalid quality for ${x.media_id}`);\n  }\n  if (!String(a.visual_summary || '').trim()) {\n    throw new Error(`ANALYSIS_WRITE_BLOCK: empty visual_summary for ${x.media_id}`);\n  }\n\n  const recommended = Array.isArray(a.recommended_use) ? a.recommended_use : [];\n\n  return {\n    json: {\n      row_number: Number(x.row_number),\n      ID_MIDIA: x.media_id,\n      ID_PROJETO: x.project_id,\n\n      TRIAGEM: String(a.selection).toUpperCase(),\n      QUALIDADE: String(a.quality).toUpperCase(),\n      'CONTEÚDO_VISUAL': String(a.visual_summary || '').trim(),\n      MELHOR_TRECHO: ANALYSIS_SOURCE === 'VIDEO_CONTACT_SHEET'\n        ? String(a.best_moment || '').trim()\n        : '',\n      USAR_EM: recommended.join(', '),\n\n      ANALYSIS_STATUS: 'ANALYZED',\n      ANALYSIS_VERSION: 'SM3_TRIAGE_V1',\n      ANALYSIS_SOURCE: ANALYSIS_SOURCE,\n      VISION_PROVIDER: x.provider,\n      VISION_MODEL: x.model,\n      ANALYZED_AT: now,\n      ANALYSIS_ERROR: '',\n      EDITORIAL_SCORE: clampScore(a.editorial_score, 'editorial_score'),\n      PROXY_STATUS: 'LOCAL_READY',\n\n      ANALYSIS_STAGE: String(a.stage || '').toUpperCase(),\n      SHOT_TYPE: String(a.shot_type || '').toUpperCase(),\n      TECHNICAL_NOTES: String(a.technical_notes || '').trim(),\n      TECHNICAL_SCORE: clampScore(a.technical_score, 'technical_score'),\n      COMPOSITION_SCORE: clampScore(a.composition_score, 'composition_score'),\n      TATTOO_VISIBILITY: clampScore(a.tattoo_visibility, 'tattoo_visibility'),\n      ANALYSIS_CONFIDENCE: clampScore(a.confidence, 'confidence'),\n      REDUNDANCY_HINT: String(a.redundancy_hint || '').trim()\n    }\n  };\n});\n"
      },
