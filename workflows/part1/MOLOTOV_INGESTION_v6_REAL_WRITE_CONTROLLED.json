    {
      "parameters": {
        "jsCode": "const discovered = $('NORMALIZE — MEDIA').all().map(i => i.json);\nconst existing = $input.all().map(i => i.json);\n\nfunction extractDriveId(url) {\n  if (!url) return null;\n  for (const r of [/\\/file\\/d\\/([^/]+)/, /[?&]id=([^&]+)/, /\\/d\\/([^/]+)/]) {\n    const m = String(url).match(r);\n    if (m?.[1]) return m[1];\n  }\n  return null;\n}\n\nconst driveIds = new Set();\nconst projectNames = new Set();\n\nfor (const row of existing) {\n  const d = extractDriveId(row.LINK_DRIVE);\n  if (d) driveIds.add(d);\n  const pid = String(row.ID_PROJETO || '').trim().toUpperCase();\n  const fn = String(row.ARQUIVO || '').trim().toLowerCase();\n  if (pid && fn) projectNames.add(`${pid}::${fn}`);\n}\n\nreturn discovered.map(a => {\n  const scoped = `${String(a.project_id || '').toUpperCase()}::${String(a.file_name || '').trim().toLowerCase()}`;\n  const byDrive = Boolean(a.drive_file_id && driveIds.has(a.drive_file_id));\n  const byScopedName = Boolean(a.project_id && a.file_name && projectNames.has(scoped));\n  const exists = byDrive || byScopedName;\n  return { json: {\n    ...a,\n    already_exists: exists,\n    match_method: byDrive ? 'DRIVE_ID' : byScopedName ? 'PROJECT_FILE_NAME' : 'NONE',\n    ingestion_action: exists ? 'SKIP' : 'INSERT'\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "id": "73a5258c-d130-42e7-abb9-458f86d294ee",
      "name": "IDEMPOTENCY — PROJECT SCOPED"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst stats = {};\nfor (const x of items) {\n  const p = x.project_id || 'NO_PROJECT';\n  stats[p] ??= {total:0, INSERT:0, SKIP:0};\n  stats[p].total++;\n  stats[p][x.ingestion_action] = (stats[p][x.ingestion_action] || 0) + 1;\n}\nreturn items.map(x => ({json:{...x, isolation_audit: stats}}));"
      },
