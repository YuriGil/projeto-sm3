      "name": "PLAN — REAL WRITES"
    },
    {
      "parameters": {
        "jsCode": "const plan = $input.first().json;\n\nconst projects = Array.isArray(plan.project_rows_to_insert)\n  ? plan.project_rows_to_insert : [];\nconst media = Array.isArray(plan.media_rows_to_insert)\n  ? plan.media_rows_to_insert : [];\n\nfunction fail(msg) {\n  throw new Error(`WRITE_SAFETY_BLOCK: ${msg}`);\n}\n\nif (!plan.dry_run) fail('planner contract invalid');\n\nconst mediaIds = media.map(r => String(r.ID_MIDIA || '').trim());\nif (new Set(mediaIds).size !== mediaIds.length) fail('duplicate ID_MIDIA in write batch');\n\nconst driveIds = media.map(r => String(r.DRIVE_FILE_ID || '').trim()).filter(Boolean);\nif (new Set(driveIds).size !== driveIds.length) fail('duplicate DRIVE_FILE_ID in write batch');\n\nfor (const p of projects) {\n  if (!p.ID_PROJETO || !p.DRIVE_FOLDER_ID || p.STORAGE_STATUS !== 'ONLINE') {\n    fail(`invalid project row ${JSON.stringify(p)}`);\n  }\n}\n\nfor (const m of media) {\n  if (!m.ID_MIDIA || !m.ID_PROJETO || !m.DRIVE_FILE_ID || !m.INGESTION_KEY) {\n    fail(`invalid media row ${JSON.stringify(m)}`);\n  }\n  if (m.STORAGE_STATUS !== 'ONLINE') fail(`media ${m.ID_MIDIA} is not ONLINE`);\n}\n\nreturn [{\n  json: {\n    ...plan,\n    write_authorized: true,\n    write_authorized_at: new Date().toISOString()\n  }\n}];"
      },
