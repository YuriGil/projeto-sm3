    {
      "parameters": {
        "jsCode": "// MOLOTOV SOCIAL OS — WRITE PLAN\n// Still only calculates rows. Actual writing is armed by the next safety node.\n\nconst projectRows = $input.all().map(i => i.json);\nconst projectContexts = $('PREPARE — PROJECT CONTEXT').all().map(i => i.json);\nconst media = $('AUDIT — PROJECT ISOLATION').all().map(i => i.json);\nconst existingMediaRows = $('READ — 03_MIDIAS').all().map(i => i.json);\n\nconst now = new Date().toISOString();\nconst today = now.slice(0, 10);\n\nconst existingProjects = new Set(\n  projectRows\n    .map(r => String(r.ID_PROJETO || '').trim().toUpperCase())\n    .filter(Boolean)\n);\n\nconst uniqueProjects = new Map();\nfor (const p of projectContexts) {\n  const id = String(p.project_id || '').trim().toUpperCase();\n  if (!id) continue;\n  uniqueProjects.set(id, p);\n}\n\nconst newProjects = [];\nfor (const [id, p] of uniqueProjects.entries()) {\n  if (existingProjects.has(id)) continue;\n\n  newProjects.push({\n    ID_PROJETO: id,\n    NOME: id,\n    TIPO: 'Tattoo',\n    STATUS: 'EM TRIAGEM',\n    'SESSÕES': '',\n    DATA_INICIAL: '',\n    DATA_FINAL: '',\n    PASTA_BRUTOS: `https://drive.google.com/drive/folders/${p.project_folder_id}`,\n    'ANÁLISE_VISUAL': 'PENDENTE',\n    PRIORIDADE: '',\n    'OBSERVAÇÕES': 'Cadastro automático de projeto descoberto em 00_BRUTOS.',\n    ATUALIZADO_EM: today,\n\n    DRIVE_FOLDER_ID: p.project_folder_id,\n    STORAGE_STATUS: 'ONLINE',\n    FIRST_SEEN_AT: now,\n    LAST_SEEN_AT: now,\n    OFFLINE_AT: ''\n  });\n}\n\nlet maxMediaNumber = 0;\nfor (const r of existingMediaRows) {\n  const m = String(r.ID_MIDIA || '').trim().match(/^M(\\d+)$/i);\n  if (m) maxMediaNumber = Math.max(maxMediaNumber, Number(m[1]));\n}\n\nconst inserts = media.filter(m => m.ingestion_action === 'INSERT');\n\nconst mediaRows = inserts.map((m, index) => {\n  const id = `M${String(maxMediaNumber + index + 1).padStart(4, '0')}`;\n\n  return {\n    ID_MIDIA: id,\n    ID_PROJETO: m.project_id,\n    ARQUIVO: m.file_name,\n    LINK_DRIVE: `https://drive.google.com/file/d/${m.drive_file_id}/view`,\n    TIPO: m.media_type === 'IMAGE' ? 'FOTO' : m.media_type === 'VIDEO' ? 'VÍDEO' : m.media_type,\n    DATA_CAPTURA: '',\n    'SESSÃO': '',\n    TAMANHO: m.file_size_bytes || '',\n    TRIAGEM: 'PENDENTE',\n    QUALIDADE: '',\n    'CONTEÚDO_VISUAL': '',\n    MELHOR_TRECHO: '',\n    USAR_EM: '',\n    'OBSERVAÇÕES': 'Ingestão automática pelo MOLOTOV SOCIAL OS.',\n\n    DRIVE_FILE_ID: m.drive_file_id,\n    PROJECT_FOLDER_ID: m.project_folder_id,\n    PARENT_FOLDER_ID: m.parent_folder_id || m.project_folder_id,\n    RELATIVE_PATH: m.relative_path || m.file_name,\n    MIME_TYPE: m.mime_type || '',\n    FILE_SIZE_BYTES: m.file_size_bytes || '',\n    DRIVE_MODIFIED_AT: m.drive_modified_at || '',\n    INGESTION_KEY: m.ingestion_key,\n    CONTENT_HASH: '',\n    STORAGE_STATUS: 'ONLINE',\n    FIRST_SEEN_AT: now,\n    LAST_SEEN_AT: now,\n    OFFLINE_AT: ''\n  };\n});\n\nreturn [{\n  json: {\n    dry_run: true,\n    generated_at: now,\n    summary: {\n      discovered_projects: uniqueProjects.size,\n      existing_projects: existingProjects.size,\n      new_projects_to_insert: newProjects.length,\n      media_total_discovered: media.length,\n      media_existing_skip: media.filter(m => m.ingestion_action === 'SKIP').length,\n      media_new_to_insert: mediaRows.length,\n      next_media_id_start: mediaRows.length ? mediaRows[0].ID_MIDIA : null,\n      next_media_id_end: mediaRows.length ? mediaRows[mediaRows.length - 1].ID_MIDIA : null\n    },\n    project_rows_to_insert: newProjects,\n    media_rows_to_insert: mediaRows\n  }\n}];"
      },
