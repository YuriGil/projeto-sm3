    {
      "parameters": {
        "jsCode": "// MOLOTOV SOCIAL OS — MULTIPROJECT LINKED NORMALIZATION\n// Each media item is linked back to the project context that generated it.\n\nconst inputItems = $input.all();\n\nfunction extension(name) {\n  const parts = String(name || '').split('.');\n  return parts.length > 1 ? parts.pop().toLowerCase() : '';\n}\n\nfunction mediaType(name) {\n  const ext = extension(name);\n  if (['jpg','jpeg','png','webp','heic','heif','tif','tiff'].includes(ext)) return 'IMAGE';\n  if (['mp4','mov','m4v','avi','mkv','webm'].includes(ext)) return 'VIDEO';\n  return 'OTHER';\n}\n\nreturn inputItems.map((item, index) => {\n  const file = item.json;\n\n  const linkedProject =\n    $('PREPARE — PROJECT CONTEXT').itemMatching(index)?.json;\n\n  if (!linkedProject?.project_id || !linkedProject?.project_folder_id) {\n    throw new Error(\n      `PROJECT_LINK_NOT_FOUND: arquivo=${file.name || file.id} index=${index}`\n    );\n  }\n\n  const type = mediaType(file.name);\n  const now = new Date().toISOString();\n\n  return {\n    json: {\n      project_id: linkedProject.project_id,\n      project_folder_id: linkedProject.project_folder_id,\n      parent_folder_id: linkedProject.project_folder_id,\n\n      drive_file_id: file.id,\n      file_name: file.name,\n      extension: extension(file.name),\n\n      media_type: type,\n      is_supported_media: type === 'IMAGE' || type === 'VIDEO',\n\n      mime_type: file.mimeType || '',\n      file_size_bytes: file.size || '',\n      drive_modified_at: file.modifiedTime || '',\n      relative_path: file.name || '',\n\n      source: 'GOOGLE_DRIVE',\n      storage_status: 'ONLINE',\n      ingestion_status: 'DISCOVERED',\n      ingestion_key: `gdrive:${file.id}`,\n\n      discovery_index: index + 1,\n      discovered_at: now\n    },\n    pairedItem: { item: index }\n  };\n});"
      },
