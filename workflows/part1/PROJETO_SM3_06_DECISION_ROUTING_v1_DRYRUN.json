    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst committed = rows.filter(r => {\n  const s = String(r.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase();\n  return ['APROVADO','REVISAR','DESCARTADO'].includes(s) &&\n         String(r.APPROVAL_SOURCE || '').trim().toUpperCase() === 'HUMAN_GOOGLE_SHEETS';\n});\n\nif (committed.length === 0) {\n  return [{json:{no_work:true,route_key:'NO_WORK',message:'Nenhuma decisão humana comprometida foi encontrada.'}}];\n}\n\nreturn committed.map(r => {\n  const decision = String(r.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase();\n  const notes = String(r.APPROVAL_NOTES || '').trim();\n\n  let route_key = 'NO_WORK';\n  if (decision === 'APROVADO') route_key = 'PRODUCTION_READY';\n  else if (decision === 'REVISAR') route_key = notes ? 'REVISION_READY' : 'REVISION_NEEDS_NOTES';\n  else if (decision === 'DESCARTADO') route_key = 'EDITORIAL_CLOSED';\n\n  return {json:{\n    no_work:false,\n    route_key,\n    ID_CONTEÚDO:r.ID_CONTEÚDO,\n    ID_PROJETO:r.ID_PROJETO,\n    TÍTULO_INTERNO:r.TÍTULO_INTERNO,\n    FORMATO:r.FORMATO,\n    OBJETIVO:r.OBJETIVO,\n    PRIORIDADE:r.PRIORIDADE,\n    BRUTOS_USADOS:r.BRUTOS_USADOS,\n    HOOK:r.HOOK,\n    ROTEIRO:r.ROTEIRO,\n    LEGENDA:r.LEGENDA,\n    CTA:r.CTA,\n    TEMPLATE_ID:r.TEMPLATE_ID,\n    STATUS_EDIÇÃO:r.STATUS_EDIÇÃO,\n    STATUS_APROVAÇÃO:r.STATUS_APROVAÇÃO,\n    APPROVAL_COMMITTED_STATUS:decision,\n    APPROVAL_NOTES:notes,\n    APPROVAL_DECIDED_AT:r.APPROVAL_DECIDED_AT,\n    PLAN_RUN_ID:r.PLAN_RUN_ID,\n    CURATION_RUN_ID:r.CURATION_RUN_ID\n  }};\n});"
      },
