    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — DECISION ROUTING v2\n// Writes a durable routing state only when necessary.\n// Re-running without changes becomes NO_WORK.\n//\n// Special case for REVISAR:\n// - no APPROVAL_NOTES => REVISION_NEEDS_NOTES\n// - notes added later => REVISION_READY, even if approval status itself did not change.\n\nconst rows = $input.all().map(i => i.json);\nconst now = new Date().toISOString();\n\nconst candidates = [];\n\nfor (const r of rows) {\n  const decision = String(r.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase();\n  const source = String(r.APPROVAL_SOURCE || '').trim().toUpperCase();\n\n  if (!['APROVADO', 'REVISAR', 'DESCARTADO'].includes(decision)) continue;\n  if (source !== 'HUMAN_GOOGLE_SHEETS') continue;\n\n  const notes = String(r.APPROVAL_NOTES || '').trim();\n  const approvalAt = String(r.APPROVAL_DECIDED_AT || '').trim();\n  const routedFrom = String(r.ROUTED_FROM_APPROVAL_AT || '').trim();\n\n  let route_key = '';\n  let target = '';\n  let production = '';\n  let revision = '';\n  let editorial = '';\n\n  if (decision === 'APROVADO') {\n    route_key = 'PRODUCTION_READY';\n    target = 'PRODUCTION';\n    production = 'READY';\n    revision = 'NOT_REQUIRED';\n    editorial = 'ACTIVE';\n  } else if (decision === 'REVISAR' && notes) {\n    route_key = 'REVISION_READY';\n    target = 'REVISION';\n    production = 'BLOCKED_REVISION';\n    revision = 'READY';\n    editorial = 'ACTIVE';\n  } else if (decision === 'REVISAR') {\n    route_key = 'REVISION_NEEDS_NOTES';\n    target = 'REVISION';\n    production = 'BLOCKED_REVISION';\n    revision = 'NEEDS_NOTES';\n    editorial = 'ACTIVE';\n  } else if (decision === 'DESCARTADO') {\n    route_key = 'EDITORIAL_CLOSED';\n    target = 'CLOSED';\n    production = 'NOT_APPLICABLE';\n    revision = 'NOT_APPLICABLE';\n    editorial = 'CLOSED';\n  }\n\n  const currentRoute = String(r.ROUTING_TARGET || '').trim().toUpperCase();\n  const currentProduction = String(r.PRODUCTION_STATUS || '').trim().toUpperCase();\n  const currentRevision = String(r.REVISION_STATUS || '').trim().toUpperCase();\n  const currentEditorial = String(r.EDITORIAL_STATUS || '').trim().toUpperCase();\n\n  const approvalChanged = approvalAt && approvalAt !== routedFrom;\n  const routingMismatch =\n    currentRoute !== target ||\n    currentProduction !== production ||\n    currentRevision !== revision ||\n    currentEditorial !== editorial;\n\n  if (!approvalChanged && !routingMismatch) continue;\n\n  candidates.push({\n    json: {\n      no_work: false,\n      route_key,\n      ID_CONTEÚDO: r.ID_CONTEÚDO,\n      ID_PROJETO: r.ID_PROJETO,\n      TÍTULO_INTERNO: r.TÍTULO_INTERNO,\n      FORMATO: r.FORMATO,\n      OBJETIVO: r.OBJETIVO,\n      PRIORIDADE: r.PRIORIDADE,\n      BRUTOS_USADOS: r.BRUTOS_USADOS,\n      HOOK: r.HOOK,\n      ROTEIRO: r.ROTEIRO,\n      LEGENDA: r.LEGENDA,\n      CTA: r.CTA,\n      TEMPLATE_ID: r.TEMPLATE_ID,\n      APPROVAL_COMMITTED_STATUS: decision,\n      APPROVAL_NOTES: notes,\n      APPROVAL_DECIDED_AT: approvalAt,\n\n      ROUTING_STATUS: 'ROUTED',\n      ROUTING_VERSION: 'SM3_ROUTING_V1',\n      ROUTING_DECISION: decision,\n      ROUTING_TARGET: target,\n      ROUTED_AT: now,\n      ROUTING_SOURCE: 'HUMAN_APPROVAL_GATE',\n      ROUTED_FROM_APPROVAL_AT: approvalAt,\n      PRODUCTION_STATUS: production,\n      REVISION_STATUS: revision,\n      EDITORIAL_STATUS: editorial\n    }\n  });\n}\n\nif (candidates.length === 0) {\n  return [{\n    json: {\n      no_work: true,\n      route_key: 'NO_WORK',\n      message: 'Todas as decisões humanas já estão roteadas no estado atual.',\n      checked_at: now\n    }\n  }];\n}\n\nreturn candidates;"
      },
