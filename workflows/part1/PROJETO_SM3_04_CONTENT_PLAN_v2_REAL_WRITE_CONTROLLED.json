      "id": "acf0d6ab-0768-4223-9708-5e65f3a78f24",
      "name": "AI — PLAN CONTENT"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(i => {\n  const x = i.json;\n  const p = x.plan || {};\n  const plans = Array.isArray(p.plans) ? p.plans : [];\n\n  if (!x.project_id || !x.curation_run_id || !x.response_id) {\n    throw new Error('CONTENT_PLAN_WRITE_BLOCK: missing project/curation/response identity');\n  }\n  if (plans.length < 1 || plans.length > 4) {\n    throw new Error(`CONTENT_PLAN_WRITE_BLOCK: invalid plan count ${plans.length}`);\n  }\n\n  const seen = new Set();\n  for (const plan of plans) {\n    const key = String(plan.plan_key || '').trim();\n    if (!key || seen.has(key)) {\n      throw new Error(`CONTENT_PLAN_WRITE_BLOCK: invalid/duplicate plan_key ${key}`);\n    }\n    seen.add(key);\n\n    if (!Array.isArray(plan.media_ids) || plan.media_ids.length === 0) {\n      throw new Error(`CONTENT_PLAN_WRITE_BLOCK: no media for ${key}`);\n    }\n    if (!String(plan.template_id || '').trim()) {\n      throw new Error(`CONTENT_PLAN_WRITE_BLOCK: no template for ${key}`);\n    }\n  }\n\n  return {\n    json: {\n      project_id: x.project_id,\n      curation_run_id: x.curation_run_id,\n      provider: x.provider,\n      model: x.model,\n      response_id: x.response_id,\n      project_strategy: p.project_strategy || '',\n      confidence: Number(p.confidence || 0),\n      plans\n    }\n  };\n});"
      },
