    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — CONTENT PLAN QUEUE v2\n// Source of truth for idempotency:\n// a current plan EXISTS only if 04_CONTEUDOS contains rows with:\n// PLAN_STATUS=AI_PLANNED + PLAN_VERSION=current + CURATION_RUN_ID=current.\n//\n// If rows exist but 01_PROJETOS state is stale/missing, route to REPAIR\n// without calling AI again.\n\nconst projects = $('READ — CURATED PROJECTS').all().map(i => i.json);\nconst mediaRows = $('READ — CURATED MEDIA').all().map(i => i.json);\nconst templates = $('READ — ACTIVE TEMPLATES').all().map(i => i.json);\nconst contentRows = $('READ — EXISTING CONTENT').all().map(i => i.json);\n\nconst PLAN_VERSION = 'SM3_CONTENT_PLAN_V1';\n\nconst activeTemplates = templates\n  .filter(t => String(t.STATUS || '').trim().toUpperCase() === 'ATIVO')\n  .map(t => ({\n    template_id: t.ID_TEMPLATE,\n    name: t.NOME,\n    format: t.FORMATO,\n    dimension: t.DIMENSAO || '',\n    media_zone: t.ZONA_MIDIA || '',\n    text_zone: t.ZONA_TEXTO || '',\n    signature: t.ASSINATURA || '',\n    crop_rule: t.REGRA_CROP || '',\n    text_rule: t.REGRA_TEXTO || ''\n  }));\n\nconst out = [];\nconst audit = [];\n\nfor (const p of projects) {\n  const pid = String(p.ID_PROJETO || '').trim();\n  if (!pid) continue;\n\n  const reasons = [];\n  const storage = String(p.STORAGE_STATUS || '').trim().toUpperCase();\n  const curationStatus = String(p.CURATION_STATUS || '').trim().toUpperCase();\n  const curationRun = String(p.CURATION_RUN_ID || '').trim();\n\n  if (storage !== 'ONLINE') reasons.push(`STORAGE_STATUS=${storage || 'EMPTY'}`);\n  if (curationStatus !== 'AI_CURATED') reasons.push(`CURATION_STATUS=${curationStatus || 'EMPTY'}`);\n  if (!curationRun) reasons.push('CURATION_RUN_ID=EMPTY');\n\n  const curated = mediaRows\n    .filter(m =>\n      String(m.ID_PROJETO || '').trim() === pid &&\n      String(m.STORAGE_STATUS || '').trim().toUpperCase() === 'ONLINE' &&\n      String(m.CURATION_STATUS || '').trim().toUpperCase() === 'AI_CURATED' &&\n      String(m.CURATION_ROLE || '').trim().toUpperCase() !== 'DISCARD'\n    )\n    .map(m => {\n      const type = String(m.TIPO || '').toUpperCase();\n      const kind = type.includes('VÍDEO') || type.includes('VIDEO') ? 'video' : 'image';\n      return {\n        media_id: m.ID_MIDIA,\n        kind,\n        curation_role: m.CURATION_ROLE || '',\n        curation_rank: Number(m.CURATION_RANK || 0) || null,\n        stage: m.ANALYSIS_STAGE || '',\n        shot_type: m.SHOT_TYPE || '',\n        visual_summary: m['CONTEÚDO_VISUAL'] || '',\n        recommended_use: m.USAR_EM || '',\n        best_moment: m.MELHOR_TRECHO || ''\n      };\n    })\n    .sort((a, b) => (a.curation_rank || 999) - (b.curation_rank || 999));\n\n  if (curated.length === 0) reasons.push('NO_NON_DISCARD_CURATED_MEDIA');\n\n  const matchingPlanRows = contentRows.filter(r =>\n    String(r.ID_PROJETO || '').trim() === pid &&\n    String(r.PLAN_STATUS || '').trim().toUpperCase() === 'AI_PLANNED' &&\n    String(r.PLAN_VERSION || '').trim() === PLAN_VERSION &&\n    String(r.CURATION_RUN_ID || '').trim() === curationRun\n  );\n\n  const projectStateCurrent =\n    String(p.CONTENT_PLAN_STATUS || '').trim().toUpperCase() === 'AI_PLANNED' &&\n    String(p.CONTENT_PLAN_VERSION || '').trim() === PLAN_VERSION &&\n    String(p.CONTENT_PLAN_CURATED_FROM || '').trim() === curationRun;\n\n  let route = 'SKIP';\n  if (reasons.length === 0) {\n    if (matchingPlanRows.length === 0) route = 'PLAN';\n    else if (!projectStateCurrent) route = 'REPAIR';\n    else route = 'CURRENT';\n  }\n\n  audit.push({\n    project_id: pid,\n    eligible_base: reasons.length === 0,\n    exclusion_reasons: reasons,\n    matching_plan_rows: matchingPlanRows.length,\n    project_state_current: projectStateCurrent,\n    route\n  });\n\n  if (reasons.length > 0 || route === 'CURRENT') continue;\n\n  if (route === 'REPAIR') {\n    const first = matchingPlanRows[0] || {};\n    out.push({\n      json: {\n        route_key: 'REPAIR',\n        project_id: pid,\n        project_write: {\n          ID_PROJETO: pid,\n          CONTENT_PLAN_STATUS: 'AI_PLANNED',\n          CONTENT_PLAN_VERSION: PLAN_VERSION,\n          CONTENT_PLAN_RUN_ID: first.PLAN_RUN_ID || '',\n          CONTENT_PLAN_CURATED_FROM: curationRun,\n          CONTENT_PLAN_AT: first.GENERATED_AT || new Date().toISOString(),\n          CONTENT_PLAN_COUNT: matchingPlanRows.length,\n          CONTENT_PLAN_PROVIDER: first.PLAN_PROVIDER || '',\n          CONTENT_PLAN_MODEL: first.PLAN_MODEL || ''\n        },\n        eligibility_audit: audit\n      }\n    });\n    continue;\n  }\n\n  out.push({\n    json: {\n      route_key: 'PLAN',\n      no_work: false,\n      project_id: pid,\n      curation_run_id: curationRun,\n      hero_id: p.CURATION_HERO_ID || '',\n      narrative: p.CURATION_NARRATIVE || '',\n      carousel_order: String(p.CURATION_CAROUSEL_ORDER || '')\n        .split(',').map(x => x.trim()).filter(Boolean),\n      reel_candidate_ids: String(p.CURATION_REEL_IDS || '')\n        .split(',').map(x => x.trim()).filter(Boolean),\n      media: curated,\n      templates: activeTemplates,\n      context:\n        'Planejar conteúdo social sem publicar/agendar. Manter aprovação humana obrigatória antes de qualquer publicação.',\n      eligibility_audit: audit\n    }\n  });\n}\n\nif (out.length === 0) {\n  return [{\n    json: {\n      route_key: 'NO_WORK',\n      no_work: true,\n      status: 'CONTENT_PLAN_CURRENT_OR_NOT_ELIGIBLE',\n      message: 'Nenhum projeto precisa de novo plano de conteúdo.',\n      eligibility_audit: audit,\n      checked_at: new Date().toISOString()\n    }\n  }];\n}\n\nreturn out;"
      },
