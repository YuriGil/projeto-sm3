    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PROJETO SM3 — BUILD CONTENT ROWS\n// Generates collision-free IDs against the existing 04_CONTEUDOS snapshot.\n// Human approval is ALWAYS PENDENTE.\n\nconst inputs = $input.all().map(i => i.json);\nconst existing = $('READ — EXISTING CONTENT').all().map(i => i.json);\nconst mediaRows = $('READ — CURATED MEDIA').all().map(i => i.json);\n\nconst PLAN_VERSION = 'SM3_CONTENT_PLAN_V1';\nconst now = new Date().toISOString();\n\nconst counters = {\n  REEL: 0,\n  CARROSSEL: 0,\n  POST: 0,\n  STORY: 0\n};\n\nfor (const r of existing) {\n  const id = String(r.ID_CONTEÚDO || '').trim().toUpperCase();\n  const m = id.match(/^(REEL|CARROSSEL|POST|STORY)_(\\d+)$/);\n  if (!m) continue;\n  counters[m[1]] = Math.max(counters[m[1]], Number(m[2]) || 0);\n}\n\nconst mediaById = new Map(\n  mediaRows\n    .filter(r => String(r.ID_MIDIA || '').trim())\n    .map(r => [String(r.ID_MIDIA).trim(), r])\n);\n\nfunction prefixFor(format) {\n  const f = String(format || '').trim().toUpperCase();\n  if (f === 'REEL') return 'REEL';\n  if (f === 'CARROSSEL') return 'CARROSSEL';\n  if (f === 'STORY') return 'STORY';\n  if (f === 'FOTO') return 'POST';\n  throw new Error(`CONTENT_PLAN_WRITE_BLOCK: unsupported format ${format}`);\n}\n\nfunction normalizePriority(v) {\n  const p = String(v || '').trim().toUpperCase();\n  if (p === 'MEDIA') return 'MÉDIA';\n  return ['ALTA','MÉDIA','BAIXA'].includes(p) ? p : 'MÉDIA';\n}\n\nfunction deriveSessions(mediaIds) {\n  const sessions = new Set();\n  for (const id of mediaIds) {\n    const r = mediaById.get(id) || {};\n    let s = String(r['SESSÃO'] || '').trim();\n    if (!s) {\n      const rel = String(r.RELATIVE_PATH || '').trim();\n      const m = rel.match(/(?:^|\\/)(S\\d{2,3})(?:\\/|$)/i);\n      if (m) s = m[1].toUpperCase();\n    }\n    if (s) sessions.add(s);\n  }\n  return [...sessions].sort().join(',');\n}\n\nconst out = [];\n\nfor (const x of inputs) {\n  const projectWrite = {\n    ID_PROJETO: x.project_id,\n    CONTENT_PLAN_STATUS: 'AI_PLANNED',\n    CONTENT_PLAN_VERSION: PLAN_VERSION,\n    CONTENT_PLAN_RUN_ID: x.response_id,\n    CONTENT_PLAN_CURATED_FROM: x.curation_run_id,\n    CONTENT_PLAN_AT: now,\n    CONTENT_PLAN_COUNT: x.plans.length,\n    CONTENT_PLAN_PROVIDER: x.provider || '',\n    CONTENT_PLAN_MODEL: x.model || ''\n  };\n\n  const rows = x.plans.map((p, index) => {\n    const prefix = prefixFor(p.format);\n    counters[prefix] += 1;\n    const id = `${prefix}_${String(counters[prefix]).padStart(4, '0')}`;\n\n    const mediaIds = (p.media_ids || []).map(String);\n    const platforms = Array.isArray(p.platforms) ? p.platforms.join(' + ') : '';\n\n    return {\n      ID_CONTEÚDO: id,\n      TÍTULO_INTERNO: p.title_internal || '',\n      ID_PROJETO: x.project_id,\n      FORMATO: p.format || '',\n      OBJETIVO: p.objective || '',\n      SESSÕES_ALVO: deriveSessions(mediaIds),\n      BRUTOS_USADOS: mediaIds.join('; '),\n      HOOK: p.hook || '',\n      ROTEIRO: p.script || '',\n      LEGENDA: p.caption || '',\n      CTA: p.cta || '',\n      CAPA: p.hero_media_id ? `${p.hero_media_id} — HERO do plano` : '',\n      STATUS_EDIÇÃO: 'IDEIA',\n      STATUS_APROVAÇÃO: 'PENDENTE',\n      PLATAFORMAS: platforms,\n      ARQUIVO_FINAL: '',\n      ID_CALENDÁRIO: '',\n      OBSERVAÇÕES:\n        `Gerado automaticamente pelo Projeto SM3. Requer aprovação humana antes de qualquer publicação. ` +\n        `Racional: ${String(p.rationale || '').trim()}`,\n      PRIORIDADE: normalizePriority(p.priority),\n      DEPENDÊNCIA: p.dependency || '',\n      ORDEM_EDITORIAL: index + 1,\n\n      PLAN_STATUS: 'AI_PLANNED',\n      PLAN_VERSION: PLAN_VERSION,\n      PLAN_KEY: p.plan_key || '',\n      PLAN_PROVIDER: x.provider || '',\n      PLAN_MODEL: x.model || '',\n      PLAN_RUN_ID: x.response_id,\n      PLAN_CONFIDENCE: x.confidence,\n      CURATION_RUN_ID: x.curation_run_id,\n      TEMPLATE_ID: p.template_id || '',\n      PROJECT_STRATEGY: x.project_strategy || '',\n      GENERATED_AT: now\n    };\n  });\n\n  out.push({\n    json: {\n      project_id: x.project_id,\n      content_rows: rows,\n      project_write: projectWrite\n    }\n  });\n}\n\nreturn out;"
      },
