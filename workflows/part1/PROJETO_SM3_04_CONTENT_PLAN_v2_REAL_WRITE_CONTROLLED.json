        "specifyBody": "json",
        "jsonBody": "={{ {project_id:$json.project_id,curation_run_id:$json.curation_run_id,hero_id:$json.hero_id,narrative:$json.narrative,carousel_order:$json.carousel_order,reel_candidate_ids:$json.reel_candidate_ids,media:$json.media,templates:$json.templates,context:$json.context} }}",
