    {
      "parameters": {
        "jsCode": "// MOLOTOV SOCIAL OS\n// IDEMPOTENCY GATE\n//\n// Compara as mídias descobertas no Google Drive\n// com os registros já existentes em 03_MIDIAS.\n//\n// Não escreve nada.\n// Apenas classifica cada arquivo como:\n// EXISTS = já cadastrado\n// NEW    = ainda não cadastrado\n\nconst discovered = $('Code in JavaScript1').all().map(i => i.json);\nconst existing = $input.all().map(i => i.json);\n\n// Extrai o ID de arquivo Google Drive de um link existente em 03_MIDIAS.\nfunction extractDriveId(url) {\n  if (!url) return null;\n\n  const text = String(url);\n\n  const patterns = [\n    /\\/file\\/d\\/([^/]+)/,\n    /[?&]id=([^&]+)/,\n    /\\/d\\/([^/]+)/\n  ];\n\n  for (const pattern of patterns) {\n    const match = text.match(pattern);\n    if (match?.[1]) return match[1];\n  }\n\n  return null;\n}\n\n// Índices dos registros já existentes.\n// Usamos tanto Drive ID quanto nome do arquivo.\n// O Drive ID é a identidade principal.\n// Nome funciona como proteção para registros antigos.\nconst existingDriveIds = new Set();\nconst existingNames = new Set();\n\nfor (const row of existing) {\n  const driveId = extractDriveId(row.LINK_DRIVE);\n\n  if (driveId) {\n    existingDriveIds.add(driveId);\n  }\n\n  if (row.ARQUIVO) {\n    existingNames.add(\n      String(row.ARQUIVO).trim().toLowerCase()\n    );\n  }\n}\n\nreturn discovered.map(item => {\n\n  const driveId = item.drive_file_id;\n  const fileName = String(item.file_name || '')\n    .trim()\n    .toLowerCase();\n\n  const existsByDriveId =\n    driveId && existingDriveIds.has(driveId);\n\n  const existsByName =\n    fileName && existingNames.has(fileName);\n\n  const alreadyExists =\n    Boolean(existsByDriveId || existsByName);\n\n  return {\n    json: {\n      ...item,\n\n      already_exists: alreadyExists,\n\n      match_method:\n        existsByDriveId\n          ? 'DRIVE_ID'\n          : existsByName\n            ? 'FILE_NAME'\n            : 'NONE',\n\n      ingestion_action:\n        alreadyExists\n          ? 'SKIP'\n          : 'INSERT'\n    }\n  };\n});"
      },
