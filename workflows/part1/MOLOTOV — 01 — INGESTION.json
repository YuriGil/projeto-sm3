      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const name = item.json.name || '';\n\n  const isProject = /^TATTOO_\\d{4}$/i.test(name);\n  const isYearFolder = /^\\d{4}$/.test(name);\n\n  return {\n    json: {\n      ...item.json,\n      molotov_type: isProject\n        ? 'PROJECT'\n        : isYearFolder\n          ? 'CONTAINER'\n          : 'UNKNOWN',\n      should_ingest: isProject,\n      should_explore: !isProject,\n      discovered_at: new Date().toISOString()\n    }\n  };\n});"
      },
