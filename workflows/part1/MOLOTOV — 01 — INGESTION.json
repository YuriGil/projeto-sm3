    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Recupera o projeto que originou esta execução do LIST PROJECT MEDIA.\nconst project = $('LIST PROJECT MEDIA').itemMatching(0)?.pairedItem\n  ? $('Switch').itemMatching(0).json\n  : $('Switch').first().json;\n\n// Como o n8n preserva o item pareado, tentamos obter o projeto\n// correspondente ao lote atual.\nconst projectId = project.name;\nconst projectFolderId = project.id;\n\nfunction getExtension(name) {\n  const parts = String(name || '').split('.');\n  return parts.length > 1\n    ? parts.pop().toLowerCase()\n    : '';\n}\n\nfunction classifyMedia(name) {\n  const ext = getExtension(name);\n\n  const imageExtensions = [\n    'jpg', 'jpeg', 'png', 'webp',\n    'heic', 'heif', 'tif', 'tiff'\n  ];\n\n  const videoExtensions = [\n    'mp4', 'mov', 'm4v', 'avi',\n    'mkv', 'webm'\n  ];\n\n  if (imageExtensions.includes(ext)) return 'IMAGE';\n  if (videoExtensions.includes(ext)) return 'VIDEO';\n\n  return 'OTHER';\n}\n\nreturn items.map((item, index) => {\n  const file = item.json;\n  const name = file.name || '';\n  const mediaType = classifyMedia(name);\n\n  return {\n    json: {\n      project_id: projectId,\n      project_folder_id: projectFolderId,\n\n      drive_file_id: file.id,\n      file_name: name,\n      extension: getExtension(name),\n\n      media_type: mediaType,\n      is_supported_media:\n        mediaType === 'IMAGE' ||\n        mediaType === 'VIDEO',\n\n      source: 'GOOGLE_DRIVE',\n\n      storage_status: 'ONLINE',\n      ingestion_status: 'DISCOVERED',\n\n      ingestion_key: `gdrive:${file.id}`,\n\n      discovery_index: index + 1,\n      discovered_at: new Date().toISOString()\n    }\n  };\n});"
      },
