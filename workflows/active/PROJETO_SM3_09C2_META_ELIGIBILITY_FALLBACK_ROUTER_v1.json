      "id": "58a8d716-2a33-4d2d-8038-18abcd9ccbc1",
      "name": "META — DISCOVER LINKED PAGE",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg=$('CONFIG — META 09C.2').first().json;\nconst pages=Array.isArray($json.data)?$json.data:[];\nconst linked=pages.filter(p=>p?.instagram_business_account?.id && p?.access_token);\nif(!linked.length) throw new Error('SM3_META_NO_LINKED_PAGE_WITH_INSTAGRAM_BUSINESS_ACCOUNT');\nlet selected=null;\nconst preferred=String(cfg.preferred_page_id||'').trim();\nif(preferred){\n  selected=linked.find(p=>String(p.id)===preferred);\n  if(!selected) throw new Error('SM3_META_PREFERRED_PAGE_NOT_FOUND:'+preferred);\n}else if(linked.length===1){\n  selected=linked[0];\n}else{\n  throw new Error('SM3_META_MULTIPLE_LINKED_PAGES_SET_PREFERRED_PAGE_ID:'+linked.map(p=>p.id).join(','));\n}\nreturn [{json:{\n api_version:String(cfg.api_version||'v26.0'),\n page_id:String(selected.id),\n page_name:String(selected.name||''),\n ig_user_id:String(selected.instagram_business_account.id),\n page_access_token:String(selected.access_token),\n profile_probe_limit:Number(cfg.profile_probe_limit||5)\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
