    {
      "parameters": {
        "jsCode": "\nconst out=[];\nfor(const o of ($json.observations||[])){\n out.push({json:{row:{\n  OBSERVATION_ID:o.observation_id,\n  REFERENCE_PROFILE_ID:o.reference_profile_id,\n  NETWORK:o.network,\n  HANDLE:o.handle,\n  CONTENT_TYPE:o.content_type,\n  PLATFORM_ITEM_ID:o.platform_item_id||'',\n  URL:o.url,\n  PROVIDER:o.provider,\n  FETCHED_AT:o.fetched_at||'',\n  PUBLISHED_AT:o.published_at||'',\n  LIKES:o.likes,\n  COMMENTS:o.comments,\n  VIEWS:o.views,\n  INTERACTIONS:o.interactions,\n  ENGAGEMENT:o.engagement,\n  FOLLOWERS:o.followers,\n  MEDIA_COUNT:o.media_count,\n  RAW_SHA256:o.raw_sha256||'',\n  OBSERVATION_SHA256:o.observation_sha256||'',\n  CONFIDENCE:'',\n  STATUS:'OBSERVED',\n  CORROBORATING_PROVIDERS:o.provider,\n  CONFLICT_FIELDS:'',\n  HARVEST_RUN_ID:$json?.harvest?.run?.harvest_run_id||'',\n  NOTES:o.notes||''\n }}});\n}\nreturn out.length?out:[{json:{noop:true}}];\n"
