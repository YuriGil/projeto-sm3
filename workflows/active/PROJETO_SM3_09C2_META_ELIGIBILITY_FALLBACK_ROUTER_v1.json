    {
      "parameters": {
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst meta=$('SELECT — LINKED META PAGE').first().json;\nconst bool=x=>typeof x==='boolean'?x:['TRUE','1','YES','SIM'].includes(String(x??'').trim().toUpperCase());\nconst norm=x=>String(x??'').trim();\nconst selected=rows.filter(r=>{\n const mode=norm(r.PROVIDER_MODE||'AUTO').toUpperCase();\n return norm(r.REFERENCE_PROFILE_ID) && norm(r.HANDLE) &&\n  norm(r.NETWORK).toLowerCase()==='instagram' &&\n  bool(r.AUTO_HARVEST) &&\n  ['AUTO','META_PRIMARY','META_ONLY'].includes(mode);\n}).slice(0,Math.max(1,meta.profile_probe_limit||5));\nreturn selected.map(r=>({json:{\n reference_profile_id:norm(r.REFERENCE_PROFILE_ID),\n handle:norm(r.HANDLE).replace(/^@/,'').toLowerCase(),\n profile_url:norm(r.PROFILE_URL)||`https://www.instagram.com/${norm(r.HANDLE).replace(/^@/,'')}/`,\n allow_public_scraping:bool(r.ALLOW_PUBLIC_SCRAPING),\n active:bool(r.ACTIVE),\n human_priority:Number(r.HUMAN_PRIORITY||50)||50,\n promote_percentile:Number(r.HARVEST_PROMOTE_PERCENTILE||85)||85,\n max_items_per_run:Number(r.HARVEST_MAX_ITEMS_PER_RUN||5)||5,\n api_version:meta.api_version,\n ig_user_id:meta.ig_user_id,\n page_access_token:meta.page_access_token\n}}));\n"
      },
