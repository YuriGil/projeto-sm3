      "name": "META — BUSINESS DISCOVERY",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst src=$('BUILD — META PROFILE PROBES').item.json;\nconst now=new Date().toISOString();\nconst bd=$json?.business_discovery;\nif(!bd){\n const err=String($json?.error?.message || $json?.message || 'META_BUSINESS_DISCOVERY_UNAVAILABLE');\n return [{json:{\n  route:'FALLBACK',\n  reference_profile_id:src.reference_profile_id,\n  handle:src.handle,\n  profile_url:src.profile_url,\n  allow_public_scraping:src.allow_public_scraping,\n  meta_eligibility:'UNAVAILABLE',\n  provider_status:'SCRAPER_FALLBACK',\n  provider_last_used:'META_GRAPH',\n  provider_last_success_at:'',\n  provider_last_error_at:now,\n  provider_last_error:err.slice(0,500),\n  observations:[]\n }}];\n}\nconst observations=[{\n reference_profile_id:src.reference_profile_id,\n network:'instagram',\n handle:src.handle,\n content_type:'PROFILE',\n platform_item_id:null,\n url:src.profile_url,\n provider:'META_GRAPH',\n fetched_at:now,\n published_at:null,\n followers:bd.followers_count??null,\n media_count:bd.media_count??null,\n raw:{name:bd.name||'',username:bd.username||src.handle},\n notes:'09C2_META_BUSINESS_DISCOVERY'\n}];\nfor(const m of (Array.isArray(bd?.media?.data)?bd.media.data:[])){\n const permalink=String(m?.permalink||'');\n if(!permalink || !/instagram\\.com\\/reel\\//i.test(permalink)) continue;\n observations.push({\n  reference_profile_id:src.reference_profile_id,\n  network:'instagram',\n  handle:src.handle,\n  content_type:'REEL',\n  platform_item_id:m.id?String(m.id):null,\n  url:permalink,\n  provider:'META_GRAPH',\n  fetched_at:now,\n  published_at:m.timestamp||null,\n  likes:m.like_count??null,\n  comments:m.comments_count??null,\n  raw:{caption:m.caption||'',media_type:m.media_type||''},\n  notes:'09C2_META_BUSINESS_DISCOVERY'\n });\n}\nreturn [{json:{\n route:'META_OK',\n reference_profile_id:src.reference_profile_id,\n handle:src.handle,\n profile_url:src.profile_url,\n allow_public_scraping:src.allow_public_scraping,\n meta_eligibility:'ELIGIBLE',\n provider_status:'OK',\n provider_last_used:'META_GRAPH',\n provider_last_success_at:now,\n provider_last_error_at:'',\n provider_last_error:'',\n observations,\n profile_policy:{\n  reference_profile_id:src.reference_profile_id,\n  network:'instagram',\n  handle:src.handle,\n  auto_harvest:true,\n  promote_percentile:src.promote_percentile,\n  max_items_per_run:src.max_items_per_run,\n  active:src.active,\n  human_priority:src.human_priority\n }\n}}];\n"
      },
