      "parameters": {
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst file=$('DRIVE TRIGGER — NEW REFERENCE VIDEO').first().json;\nconst name=String(file.name||'').trim();\nconst fileId=String(file.id||'').trim();\nconst mime=String(file.mimeType||'').toLowerCase();\n\nif(!fileId||!name)throw new Error('SM3_09A4_DRIVE_TRIGGER_FILE_METADATA_MISSING');\n\nif(mime && !mime.startsWith('video/') && !/\\.(mp4|mov|m4v|webm|mkv)$/i.test(name))\n return [{json:{route:'UNMATCHED',reason:'NOT_VIDEO',drive_file_id:fileId,drive_file_name:name}}];\n\nconst norm=x=>String(x??'').trim();\nconst low=x=>norm(x).toLowerCase();\n\nconst pending=rows.filter(r=>{\n const iid=norm(r.REFERENCE_ITEM_ID);\n const type=norm(r.ITEM_TYPE).toUpperCase();\n const local=norm(r.LOCAL_MEDIA_REF);\n return /^RI_[a-f0-9]{32}$/.test(iid)&&['REEL','VIDEO','STORY'].includes(type)&&!local;\n});\n\nlet candidates=[];\nconst ri=(name.match(/RI_[a-f0-9]{32}/i)||[])[0];\nif(ri)candidates=pending.filter(r=>low(r.REFERENCE_ITEM_ID)===ri.toLowerCase());\n\nif(!candidates.length){\n const byPlatform=pending.filter(r=>{\n  const pid=norm(r.PLATFORM_ITEM_ID);\n  return pid && name.toLowerCase().includes(pid.toLowerCase());\n });\n if(byPlatform.length)candidates=byPlatform;\n}\n\nif(!candidates.length){\n const byHandle=pending.filter(r=>{\n  const h=low(r.PROFILE_HANDLE).replace(/^@/,'');\n  return h && name.toLowerCase().includes(h);\n });\n if(byHandle.length===1)candidates=byHandle;\n}\n\nif(candidates.length!==1){\n return [{json:{\n   route:'UNMATCHED',\n   reason:candidates.length?'AMBIGUOUS':'NO_REFERENCE_ITEM_MATCH',\n   drive_file_id:fileId,\n   drive_file_name:name,\n   candidate_count:candidates.length\n }}];\n}\n\nconst r=candidates[0];\nreturn [{json:{\n route:'MATCHED',\n reference_item_id:norm(r.REFERENCE_ITEM_ID),\n drive_file_id:fileId,\n drive_file_name:name,\n item_type:norm(r.ITEM_TYPE).toUpperCase(),\n profile_handle:norm(r.PROFILE_HANDLE)\n}}];\n"
      },
