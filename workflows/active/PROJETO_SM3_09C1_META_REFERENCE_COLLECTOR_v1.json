        "jsCode": "const rows=$('READ — 31 META PROFILES').all().map(i=>i.json);const cfg=$json;const norm=x=>String(x??'').trim();const b=x=>typeof x==='boolean'?x:['TRUE','1','YES','SIM'].includes(norm(x).toUpperCase());const out=[];for(const r of rows){const id=norm(r.REFERENCE_PROFILE_ID),h=norm(r.HANDLE).replace(/^@/,'').toLowerCase();if(!id||!h||norm(r.NETWORK).toLowerCase()!=='instagram')continue;if(!b(r.AUTO_HARVEST))continue;const mode=norm(r.PROVIDER_MODE)||'AUTO';if(mode==='FORCE_SCRAPER'||mode==='MANUAL')continue;out.push({json:{reference_profile_id:id,handle:h,api_version:cfg.api_version,ig_user_id:cfg.ig_user_id,promote_percentile:Number(r.HARVEST_PROMOTE_PERCENTILE||85),max_items_per_run:Number(r.HARVEST_MAX_ITEMS_PER_RUN||5),active:b(r.ACTIVE),human_priority:Number(r.HUMAN_PRIORITY||50)}});}if(!out.length)return [{json:{route:'NO_WORK'}}];return out.map(x=>({json:{route:'META',...x.json}}));"
