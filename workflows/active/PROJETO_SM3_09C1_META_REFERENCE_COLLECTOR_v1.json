        "jsCode": "const src=$json.business_discovery;if(!src)throw new Error('SM3_09C1_META_BUSINESS_DISCOVERY_EMPTY');const q=$('BUILD — META BUSINESS DISCOVERY QUEUE').item.json;const fetched=new Date().toISOString();const obs=[{reference_profile_id:q.reference_profile_id,network:'instagram',handle:q.handle,content_type:'PROFILE',platform_item_id:null,url:'https://www.instagram.com/'+q.handle+'/',provider:'META_GRAPH',fetched_at:fetched,followers:src.followers_count??null,media_count:src.media_count??null,raw:{id:src.id,username:src.username,name:src.name},notes:'META_BUSINESS_DISCOVERY_PROFILE'}];for(const m of (src.media?.data||[])){const isReel=String(m.media_product_type||'').toUpperCase()==='REELS'||String(m.media_type||'').toUpperCase()==='VIDEO';if(!isReel)continue;obs.push({reference_profile_id:q.reference_profile_id,network:'instagram',handle:q.handle,content_type:'REEL',platform_item_id:String(m.id||''),url:String(m.permalink||''),provider:'META_GRAPH',fetched_at:fetched,published_at:m.timestamp||null,likes:m.like_count??null,comments:m.comments_count??null,interactions:(m.like_count??0)+(m.comments_count??0),raw:{caption:m.caption||'',media_type:m.media_type,media_product_type:m.media_product_type},notes:'META_BUSINESS_DISCOVERY_REEL'});}return [{json:{observations:obs,harvest_after_ingest:true,promotion_enabled:true,source_window_from:new Date(Date.now()-30*86400000).toISOString().slice(0,10),source_window_to:new Date().toISOString().slice(0,10),profile_policies:[{reference_profile_id:q.reference_profile_id,network:'instagram',handle:q.handle,auto_harvest:true,promote_percentile:q.promote_percentile,max_items_per_run:q.max_items_per_run,active:q.active,human_priority:q.human_priority}],notes:'09C1_META_PRIMARY'}}];"
