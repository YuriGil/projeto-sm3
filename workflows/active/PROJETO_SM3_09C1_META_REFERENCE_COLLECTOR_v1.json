        "jsCode": "\nconst r=$json;\nconst out=[];\nfor(const o of (r.observations||[])){\n  out.push({json:{target:'OBS',row:{\n    OBSERVATION_ID:o.observation_id,REFERENCE_PROFILE_ID:o.reference_profile_id,NETWORK:o.network,HANDLE:o.handle,\n    CONTENT_TYPE:o.content_type,PLATFORM_ITEM_ID:o.platform_item_id||'',URL:o.url,PROVIDER:o.provider,FETCHED_AT:o.fetched_at,\n    PUBLISHED_AT:o.published_at||'',LIKES:o.likes,COMMENTS:o.comments,VIEWS:o.views,INTERACTIONS:o.interactions,ENGAGEMENT:o.engagement,\n    FOLLOWERS:o.followers,MEDIA_COUNT:o.media_count,RAW_SHA256:o.raw_sha256,OBSERVATION_SHA256:o.observation_sha256,\n    CONFIDENCE:'',STATUS:'RAW',CORROBORATING_PROVIDERS:'',CONFLICT_FIELDS:'',HARVEST_RUN_ID:r.harvest?.run?.harvest_run_id||'',NOTES:o.notes||''\n  }}});\n}\nfor(const c of (r.consensus||[])){\n  out.push({json:{target:'OBS',row:{\n    OBSERVATION_ID:c.observation_id,REFERENCE_PROFILE_ID:c.reference_profile_id,NETWORK:c.network,HANDLE:c.handle,\n    CONTENT_TYPE:c.content_type,PLATFORM_ITEM_ID:c.platform_item_id||'',URL:c.url,PROVIDER:c.selected_provider||c.provider,FETCHED_AT:c.fetched_at,\n    PUBLISHED_AT:c.published_at||'',LIKES:c.likes,COMMENTS:c.comments,VIEWS:c.views,INTERACTIONS:c.interactions,ENGAGEMENT:c.engagement,\n    FOLLOWERS:c.followers,MEDIA_COUNT:c.media_count,RAW_SHA256:c.raw_sha256,OBSERVATION_SHA256:c.observation_sha256,\n    CONFIDENCE:c.confidence,STATUS:c.status,CORROBORATING_PROVIDERS:(c.corroborating_providers||[]).join(','),\n    CONFLICT_FIELDS:(c.conflict_fields||[]).join(','),HARVEST_RUN_ID:r.harvest?.run?.harvest_run_id||'',NOTES:'CONSENSUS_VIEW'\n  }}});\n}\nreturn out;\n"
