        "jsCode": "const rows=$('READ — 32_REFERENCE_ITEMS').all().map(i=>i.json);const m=$json;if(m.ok!==true||m.contract_version!=='SM3_REFERENCE_MEDIA_ACQUISITION_V1')throw new Error('SM3_09A3_REFERENCE_MEDIA_LIST_INVALID');const latest=new Map();for(const a of (m.acquisitions||[])){const old=latest.get(a.reference_item_id);if(!old||String(a.created_at||'')>String(old.created_at||''))latest.set(a.reference_item_id,a);}const out=[];for(const r of rows){const iid=String(r.REFERENCE_ITEM_ID||'').trim();if(!iid)continue;const a=latest.get(iid);if(!a)continue;const current=String(r.LOCAL_MEDIA_REF||'').trim();if(current===String(a.canonical_local_media_ref||''))continue;out.push({json:{row:{REFERENCE_ITEM_ID:iid,LOCAL_MEDIA_REF:a.canonical_local_media_ref,VISUAL_ANALYSIS_STATUS:String(r.VISUAL_ANALYSIS_STATUS||'PENDING'),TEMPORAL_ANALYSIS_STATUS:'READY',UPDATED_AT:new Date().toISOString(),SYNC_STATUS:'MEDIA_READY',SYNC_MESSAGE:'ACQUIRED:'+a.acquisition_id,LAST_SYNC_AT:new Date().toISOString()}}});}if(!out.length)return [{json:{route:'NO_WORK'}}];return out.map(x=>({json:{route:'WRITE',...x.json}}));"
