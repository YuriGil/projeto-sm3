        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst norm=x=>String(x??'').trim();\nconst pending=[];\n\nfor(const r of rows){\n  const existingId=norm(r.REFERENCE_ITEM_ID);\n  const rawUrl=norm(r.URL);\n  const ph=norm(r.PROFILE_HANDLE);\n  const pid=norm(r.REFERENCE_PROFILE_ID);\n\n  // Empty/preformatted rows are ignored.\n  if(!existingId&&!rawUrl&&!ph&&!pid)continue;\n\n  // Canonical item rows are immutable in 09A.2 and are skipped.\n  if(existingId){\n    if(!/^RI_[a-f0-9]{32}$/.test(existingId))\n      throw new Error('SM3_09A2_REFERENCE_ITEM_ID_INVALID:'+existingId);\n    continue;\n  }\n\n  if(!rawUrl)throw new Error('SM3_09A2_ITEM_URL_REQUIRED');\n  pending.push(r);\n}\n\nreturn [{json:{\n  route:pending.length?'NEED_PROFILE_LOOKUP':'NO_WORK',\n  pending_count:pending.length,\n  candidates:pending\n}}];\n"
