    {
      "parameters": {
        "jsCode": "\nconst now=new Date().toISOString();\nconst out=[];\nconst requestItems=$('BUILD — REFERENCE ITEM INTAKE QUEUE').all().filter(i=>i.json.route==='SYNC');\nfor(let idx=0; idx<$input.all().length; idx++){\n  const r=$input.all()[idx].json;\n  const q=requestItems[idx]?.json;\n  if(!q)throw new Error('SM3_09A2_QUEUE_RESPONSE_PAIRING_FAILED:'+idx);\n  if(r.ok!==true||r.contract_version!=='SM3_REFERENCE_ITEM_V1'||\n     !/^RI_[a-f0-9]{32}$/.test(String(r.reference_item_id||''))||\n     !/^[a-f0-9]{64}$/.test(String(r.item_sha256||'')))\n    throw new Error('SM3_09A2_REFERENCE_ITEM_RESULT_INVALID');\n\n  out.push({json:{currentRow:{\n    REFERENCE_ITEM_ID:r.reference_item_id,\n    REFERENCE_PROFILE_ID:r.reference_profile_id,\n    NETWORK:r.network,\n    ITEM_TYPE:r.item_type,\n    PLATFORM_ITEM_ID:r.platform_item_id||'',\n    URL:q.client_context.sheet_url,\n    CAPTION:r.caption||'',\n    PUBLISHED_AT:r.published_at||'',\n    SOURCE:r.source,\n    LOCAL_MEDIA_REF:r.local_media_ref||'',\n    VISUAL_ANALYSIS_STATUS:r.visual_analysis_status,\n    TEMPORAL_ANALYSIS_STATUS:r.temporal_analysis_status,\n    ITEM_SHA256:r.item_sha256,\n    CREATED_AT:r.created_at,\n    UPDATED_AT:r.updated_at||r.created_at,\n    NOTES:r.notes||'',\n    PROFILE_HANDLE:q.client_context.profile_handle,\n    SYNC_STATUS:'SYNCED',\n    SYNC_MESSAGE:(r.reused_existing?'REUSED_EXISTING':'CREATED')+'|CANONICAL_URL='+q.client_context.canonical_url,\n    LAST_SYNC_AT:now\n  }}});\n}\nreturn out;\n"
      },
