        "jsCode": "\nconst h=$json;\nif(h.reference_item_contract!=='SM3_REFERENCE_ITEM_V1'||h.reference_corpus_policy!=='SM3_REFERENCE_CORPUS_POLICY_V1')throw new Error('SM3_09A2_WORKER_CONTRACT_INVALID');\nif(h.reference_item_contract!=='SM3_REFERENCE_ITEM_V1')throw new Error('SM3_09A2_REFERENCE_ITEM_CONTRACT_INVALID');\nif(h.reference_corpus_policy!=='SM3_REFERENCE_CORPUS_POLICY_V1')throw new Error('SM3_09A2_REFERENCE_POLICY_INVALID');\nif(h.reference_foundation_override_allowed!==false||h.reference_copying_allowed!==false)\n  throw new Error('SM3_09A2_REFERENCE_GUARDRAILS_INVALID');\nreturn [{json:{ok:true,worker_version:h.version,contract:h.reference_item_contract}}];\n"
