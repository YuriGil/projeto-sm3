    {
      "parameters": {
        "jsCode": "\nconst profiles=$input.all().map(i=>i.json);\nconst candidates=$('BUILD — REFERENCE ITEM CANDIDATES').first().json.candidates||[];\n\nconst norm=x=>String(x??'').trim();\nconst handle=x=>norm(x).replace(/^@/,'').toLowerCase();\n\nconst profileById=new Map();\nconst profileByHandle=new Map();\nfor(const p of profiles){\n  const id=norm(p.REFERENCE_PROFILE_ID);\n  const h=handle(p.HANDLE);\n  const network=norm(p.NETWORK).toLowerCase();\n  if(id&&/^RP_[a-f0-9]{32}$/.test(id))profileById.set(id,p);\n  if(h&&network)profileByHandle.set(network+'|'+h,p);\n}\n\nconst parseItemUrl=(raw)=>{\n  let s=norm(raw);\n  if(!s)return null;\n  s=s.replace(/\\s+/g,'');\n  if(!/^https?:\\/\\//i.test(s))s='https://'+s;\n  const noFrag=s.split('#')[0];\n  const noQuery=noFrag.split('?')[0];\n\n  let m=noQuery.match(/^https?:\\/\\/(?:www\\.)?instagram\\.com\\/(reel|p|tv|stories)\\/([^\\/?#]+)(?:\\/.*)?$/i);\n  if(m){\n    const kind=m[1].toLowerCase();\n    const platformItemId=m[2];\n    const inferred=(kind==='reel'||kind==='tv')?'REEL':kind==='stories'?'STORY':'POST';\n    return {\n      network:'instagram',\n      platform_item_id:platformItemId,\n      item_type:inferred,\n      canonical_url:`https://www.instagram.com/${kind}/${platformItemId}/`\n    };\n  }\n\n  m=noQuery.match(/^https?:\\/\\/(?:www\\.)?tiktok\\.com\\/@([^\\/?#]+)\\/video\\/([0-9]+)\\/?$/i);\n  if(m){\n    return {\n      network:'tiktok',\n      platform_item_id:m[2],\n      item_type:'VIDEO',\n      canonical_url:`https://www.tiktok.com/@${m[1].toLowerCase()}/video/${m[2]}`\n    };\n  }\n\n  throw new Error('SM3_09A2_REFERENCE_ITEM_URL_INVALID:'+raw);\n};\n\nconst allowedTypes=new Set(['REEL','POST','CAROUSEL','STORY','VIDEO']);\nconst allowedSources=new Set(['METRICOOL','MANUAL_URL','DRIVE_UPLOAD','CHATGPT']);\nconst seen=new Set();\nconst out=[];\n\nfor(const r of candidates){\n  const rawUrl=norm(r.URL);\n  const ph=handle(r.PROFILE_HANDLE);\n  const requestedProfileId=norm(r.REFERENCE_PROFILE_ID);\n  const parsed=parseItemUrl(rawUrl);\n\n  let profile=null;\n  if(requestedProfileId){\n    profile=profileById.get(requestedProfileId);\n    if(!profile)throw new Error('SM3_09A2_REFERENCE_PROFILE_ID_NOT_FOUND:'+requestedProfileId);\n  }else if(ph){\n    profile=profileByHandle.get(parsed.network+'|'+ph);\n    if(!profile)throw new Error('SM3_09A2_REFERENCE_PROFILE_HANDLE_NOT_FOUND:'+parsed.network+'|'+ph);\n  }else{\n    throw new Error('SM3_09A2_PROFILE_HANDLE_OR_ID_REQUIRED:'+rawUrl);\n  }\n\n  const pid=norm(profile.REFERENCE_PROFILE_ID);\n  const pnetwork=norm(profile.NETWORK).toLowerCase();\n  const canonicalHandle=handle(profile.HANDLE);\n  if(pnetwork!==parsed.network)\n    throw new Error('SM3_09A2_ITEM_PROFILE_NETWORK_MISMATCH:'+pnetwork+':'+parsed.network+':'+rawUrl);\n\n  const rowType=norm(r.ITEM_TYPE).toUpperCase();\n  const itemType=rowType||parsed.item_type;\n  if(!allowedTypes.has(itemType))throw new Error('SM3_09A2_ITEM_TYPE_INVALID:'+itemType);\n  if(parsed.item_type==='REEL'&&itemType!=='REEL')\n    throw new Error('SM3_09A2_URL_TYPE_MISMATCH:'+itemType+':REEL');\n  if(parsed.item_type==='STORY'&&itemType!=='STORY')\n    throw new Error('SM3_09A2_URL_TYPE_MISMATCH:'+itemType+':STORY');\n  if(parsed.network==='tiktok'&&itemType!=='VIDEO')\n    throw new Error('SM3_09A2_URL_TYPE_MISMATCH:'+itemType+':VIDEO');\n\n  const source=(norm(r.SOURCE)||'MANUAL_URL').toUpperCase();\n  if(!allowedSources.has(source))throw new Error('SM3_09A2_ITEM_SOURCE_INVALID:'+source);\n\n  const dedupe=pid+'|'+parsed.canonical_url;\n  if(seen.has(dedupe))throw new Error('SM3_09A2_DUPLICATE_REFERENCE_ITEM_IN_SHEET:'+dedupe);\n  seen.add(dedupe);\n\n  out.push({json:{\n    route:'SYNC',\n    reference_profile_id:pid,\n    network:pnetwork,\n    item_type:itemType,\n    platform_item_id:norm(r.PLATFORM_ITEM_ID)||parsed.platform_item_id||null,\n    url:parsed.canonical_url,\n    caption:norm(r.CAPTION),\n    published_at:norm(r.PUBLISHED_AT)||null,\n    source,\n    local_media_ref:norm(r.LOCAL_MEDIA_REF)||null,\n    notes:norm(r.NOTES),\n    client_context:{\n      sheet_url:rawUrl,\n      profile_handle:canonicalHandle,\n      canonical_url:parsed.canonical_url\n    }\n  }});\n}\n\nif(!out.length)return [{json:{route:'NO_WORK'}}];\nreturn out;\n"
      },
