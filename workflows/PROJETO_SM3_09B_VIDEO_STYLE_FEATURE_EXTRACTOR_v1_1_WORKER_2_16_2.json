      "parameters": {
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst norm=x=>String(x??'').trim();\nconst out=[];\nfor(const r of rows){\n  const iid=norm(r.REFERENCE_ITEM_ID);\n  const kind=norm(r.ITEM_TYPE).toUpperCase();\n  const local=norm(r.LOCAL_MEDIA_REF);\n  const temporal=norm(r.TEMPORAL_ANALYSIS_STATUS).toUpperCase();\n  if(!iid)continue;\n  if(!/^RI_[a-f0-9]{32}$/.test(iid))throw new Error('SM3_09B_REFERENCE_ITEM_ID_INVALID:'+iid);\n  if(!['REEL','VIDEO','STORY'].includes(kind))continue;\n  if(!local)continue;\n  if(['ANALYZED','VERIFIED','ANALYZED_V1'].includes(temporal))continue;\n  out.push({json:{route:'ANALYZE',reference_item_id:iid,local_media_ref:local,preference_signal:'UNKNOWN',notes:'09B_REFERENCE_VIDEO_STYLE_FEATURE_EXTRACTOR'}});\n}\nif(!out.length)return [{json:{route:'NO_WORK'}}];\nreturn out;\n"
      },
