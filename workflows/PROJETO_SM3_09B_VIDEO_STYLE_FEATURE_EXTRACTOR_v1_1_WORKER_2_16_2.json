    {
      "parameters": {
        "jsCode": "\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  if(r.ok!==true||!r.analysis)throw new Error('SM3_09B_ANALYSIS_RESPONSE_INVALID');\n  const a=r.analysis,f=a.features||{};\n  if(a.contract_version!=='SM3_REFERENCE_VIDEO_ANALYSIS_V1'||\n     a.analyzer_version!=='SM3_REFERENCE_VIDEO_ANALYZER_V1'||\n     !/^RVA_[a-f0-9]{32}$/.test(String(a.analysis_id||''))||\n     !/^RFO_[a-f0-9]{32}$/.test(String(a.feature_observation_id||''))||\n     !/^[a-f0-9]{64}$/.test(String(a.source_sha256||''))||\n     !/^[a-f0-9]{64}$/.test(String(a.feature_sha256||''))||\n     !/^[a-f0-9]{64}$/.test(String(a.analysis_sha256||'')))\n    throw new Error('SM3_09B_ANALYSIS_CONTRACT_OR_HASH_INVALID');\n  out.push({json:{write_target:'FEATURE',featureRow:{\n    FEATURE_OBSERVATION_ID:a.feature_observation_id,REFERENCE_ITEM_ID:a.reference_item_id,FEATURE_SCHEMA_VERSION:'SM3_REFERENCE_FEATURES_V1',\n    VIDEO_DURATION_S:f.video_duration_s??'',HOOK_DURATION_S:f.hook_duration_s??'',CUTS_PER_10S:f.cuts_per_10s??'',MEDIAN_SHOT_S:f.median_shot_s??'',\n    CAMERA_MOTION:f.camera_motion??'UNKNOWN',SUBJECT_SCALE:f.subject_scale??'UNKNOWN',SUBJECT_COVERAGE:f.subject_coverage??'',\n    TEXT_DENSITY:f.text_density??'UNKNOWN',TEXT_POSITION:f.text_position??'UNKNOWN',TRANSITION_STYLE:f.transition_style??'UNKNOWN',\n    SPEED_RAMP:f.speed_ramp??'UNKNOWN',BEAT_SYNC:f.beat_sync??'UNKNOWN',COLOR_CONTRAST:f.color_contrast??'UNKNOWN',\n    COLOR_SATURATION:f.color_saturation??'UNKNOWN',COLOR_TEMPERATURE:f.color_temperature??'UNKNOWN',SHARPNESS_GRAIN:f.sharpness_grain??'UNKNOWN',\n    IDENTITY_USAGE:f.identity_usage??'UNKNOWN',TATTOO_PRESENTATION:f.tattoo_presentation??'UNKNOWN',STORY_STRUCTURE:f.story_structure??'UNKNOWN',\n    PREFERENCE_SIGNAL:a.preference_signal??'UNKNOWN',ANALYSIS_CONFIDENCE:a.analysis_confidence??0,SOURCE_SHA256:a.source_sha256,FEATURE_SHA256:a.feature_sha256\n  }}});\n  out.push({json:{write_target:'ITEM_STATUS',itemRow:{REFERENCE_ITEM_ID:a.reference_item_id,VISUAL_ANALYSIS_STATUS:'ANALYZED_V1',TEMPORAL_ANALYSIS_STATUS:'ANALYZED_V1'}}});\n}\nreturn out;\n"
