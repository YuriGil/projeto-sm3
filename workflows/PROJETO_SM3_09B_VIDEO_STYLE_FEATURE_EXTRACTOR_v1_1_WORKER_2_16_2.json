      "parameters": {
        "jsCode": "\nconst h=$json;\nif(h.version!=='2.16.2')throw new Error('SM3_09B_WORKER_VERSION_INVALID:'+h.version);\nif(h.reference_video_analysis!==true||\n   h.reference_video_analysis_contract!=='SM3_REFERENCE_VIDEO_ANALYSIS_V1'||\n   h.reference_video_analyzer_version!=='SM3_REFERENCE_VIDEO_ANALYZER_V1'||\n   h.reference_video_vision_schema!=='SM3_REFERENCE_VIDEO_VISION_V1'||\n   h.reference_feature_contract!=='SM3_REFERENCE_FEATURES_V1'||\n   h.reference_feature_idempotency_stable!==true)\n  throw new Error('SM3_09B_REFERENCE_VIDEO_CONTRACT_INVALID');\nif(h.reference_external_style_is_evidence_only!==true||\n   h.reference_foundation_override_allowed!==false||\n   h.reference_copying_allowed!==false)\n  throw new Error('SM3_09B_REFERENCE_GUARDRAILS_INVALID');\nreturn [{json:{ok:true,worker_version:h.version}}];\n"
      },
