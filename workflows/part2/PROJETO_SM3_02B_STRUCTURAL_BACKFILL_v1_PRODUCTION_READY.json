    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const all = $input.all().map(i => i.json);\nconst items = all.filter(x => !x.queue_empty);\n\nconst summary = {\n  queue_empty: items.length === 0,\n  queued_total: items.length,\n  image_original: items.filter(x => x.analysis_route === 'IMAGE_ORIGINAL').length,\n  video_proxy: items.filter(x => x.analysis_route === 'VIDEO_PROXY').length,\n  unsupported: items.filter(x => x.analysis_route === 'UNSUPPORTED').length,\n  projects: {}\n};\n\nfor (const x of items) {\n  const p = x.ID_PROJETO || 'NO_PROJECT';\n  summary.projects[p] = (summary.projects[p] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    dry_run: false,\n    summary,\n    queued_ids: items.map(x => x.ID_MIDIA),\n    queue: items\n  }\n}];"
      },
