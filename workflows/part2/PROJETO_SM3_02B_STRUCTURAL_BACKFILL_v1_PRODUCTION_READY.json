    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\n\nreturn items.map(x => {\n  const a = x.analysis || {};\n  const s = a.structure || {};\n  const anatomy = s.anatomy || {};\n  const tattoo = s.tattoo || {};\n  const framing = s.framing || {};\n  const crops = s.crops || {};\n\n  const confidence = Number(s.structural_confidence);\n  if (!x.media_id) throw new Error('STRUCTURAL_BACKFILL_BLOCK: missing media_id');\n  if (!Number.isFinite(confidence) || confidence < 0 || confidence > 100) {\n    throw new Error(`STRUCTURAL_BACKFILL_BLOCK: invalid confidence for ${x.media_id}`);\n  }\n\n  const cropGuidance = {\n    reel_9x16: crops.reel_9x16 || {},\n    story_9x16: crops.story_9x16 || {},\n    feed_4x5: crops.feed_4x5 || {},\n    square_1x1: crops.square_1x1 || {},\n    landscape_16x9: crops.landscape_16x9 || {}\n  };\n\n  const formatFit = Object.fromEntries(\n    Object.entries(cropGuidance).map(([k, v]) => [k, {\n      viability_score: v.viability_score,\n      strategy: v.strategy,\n      anchor: v.anchor,\n      rect_reliability: v.rect_reliability,\n      rationale: v.rationale\n    }])\n  );\n\n  return {json:{\n    ID_MIDIA: x.media_id,\n    STRUCTURAL_ANALYSIS_VERSION: 'SM3_STRUCTURAL_V1',\n    GEOMETRY_MODE: String(s.geometry_mode || ''),\n    BODY_REGION: String(anatomy.body_region || ''),\n    BODY_SUBREGION: String(anatomy.body_subregion || ''),\n    VIEW_ANGLE: String(anatomy.view_angle || ''),\n    BODY_POSE: String(anatomy.body_pose || ''),\n    TATTOO_ORIENTATION: String(tattoo.orientation || ''),\n    TATTOO_STYLE_TAGS: Array.isArray(tattoo.style_tags) ? tattoo.style_tags.join(', ') : '',\n    TATTOO_SUBJECT_PRIMARY: String(tattoo.subject_primary || ''),\n    TATTOO_SUBJECT_TAGS: Array.isArray(tattoo.subject_tags) ? tattoo.subject_tags.join(', ') : '',\n    TATTOO_STAGE_STRUCTURAL: String(tattoo.stage || ''),\n    TATTOO_COVERAGE: String(tattoo.coverage || ''),\n    COMPOSITION_SHAPE: String(tattoo.composition_shape || ''),\n    FOCAL_DESCRIPTION: String(framing.focal_description || ''),\n    FOCUS_POINT_NORM: JSON.stringify(framing.focus_point_norm || {}),\n    TATTOO_BBOX_NORM: JSON.stringify(framing.tattoo_bbox_norm || {}),\n    CROP_GUIDANCE_JSON: JSON.stringify(cropGuidance),\n    FORMAT_FIT_JSON: JSON.stringify(formatFit),\n    BEST_FORMATS: Array.isArray(s.best_formats) ? s.best_formats.join(', ') : '',\n    STRUCTURAL_CONFIDENCE: Math.round(confidence),\n    STRUCTURAL_NOTES: String(s.notes || '')\n  }};\n});"
      },
