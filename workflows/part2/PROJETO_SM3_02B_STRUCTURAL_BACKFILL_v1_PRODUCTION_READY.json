    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Projeto SM3 — structural backfill for media that is CURRENTLY production-ready.\n// Generic: no project/media IDs are hardcoded.\n\nconst mediaRows = $input.all().map(i => i.json);\nconst contentRows = $('READ — PRODUCTION READY CONTENT').all().map(i => i.json);\n\nconst targetIds = new Set();\n\nfor (const c of contentRows) {\n  const productionReady =\n    String(c.ROUTING_TARGET || '').trim().toUpperCase() === 'PRODUCTION' &&\n    String(c.PRODUCTION_STATUS || '').trim().toUpperCase() === 'READY' &&\n    String(c.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase() === 'APROVADO';\n\n  if (!productionReady) continue;\n\n  const ids = String(c.BRUTOS_USADOS || '').match(/M\\d{4}/g) || [];\n  for (const id of ids) targetIds.add(id);\n}\n\nconst eligible = mediaRows.filter(r =>\n  targetIds.has(String(r.ID_MIDIA || '').trim()) &&\n  String(r.STORAGE_STATUS || '').trim().toUpperCase() === 'ONLINE' &&\n  String(r.STRUCTURAL_ANALYSIS_VERSION || '').trim() !== 'SM3_STRUCTURAL_V1'\n);\n\nif (eligible.length === 0) {\n  return [{\n    json: {\n      queue_empty: true,\n      analysis_route: 'NO_WORK',\n      target_media_ids: [...targetIds],\n      queued_for_analysis_at: new Date().toISOString()\n    }\n  }];\n}\n\nreturn eligible.map(r => {\n  const type = String(r.TIPO || '').trim().toUpperCase();\n  const route =\n    type === 'FOTO' ? 'IMAGE_ORIGINAL' :\n    type === 'VÍDEO' || type === 'VIDEO' ? 'VIDEO_PROXY' :\n    'UNSUPPORTED';\n\n  return {\n    json: {\n      ...r,\n      queue_empty: false,\n      analysis_route: route,\n      structural_backfill: true,\n      queued_for_analysis_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "4136e57a-f5ba-4084-bcb9-f12d11ad934e",
