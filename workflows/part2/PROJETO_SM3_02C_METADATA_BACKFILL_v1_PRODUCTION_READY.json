    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Projeto SM3 — metadata backfill for CURRENT production-ready media.\n// No AI call. Uses media-worker deterministic process-path only.\n\nconst mediaRows = $input.all().map(i => i.json);\nconst contentRows = $('READ — PRODUCTION READY CONTENT').all().map(i => i.json);\n\nconst targetIds = new Set();\n\nfor (const c of contentRows) {\n  const productionReady =\n    String(c.ROUTING_TARGET || '').trim().toUpperCase() === 'PRODUCTION' &&\n    String(c.PRODUCTION_STATUS || '').trim().toUpperCase() === 'READY' &&\n    (\n      String(c.EDITORIAL_COMMITTED_STATUS || '').trim().toUpperCase() === 'APROVADO' ||\n      String(c.APPROVAL_COMMITTED_STATUS || '').trim().toUpperCase() === 'APROVADO'\n    );\n\n  if (!productionReady) continue;\n\n  const ids = String(c.BRUTOS_USADOS || '').match(/M\\d{4}/g) || [];\n  for (const id of ids) targetIds.add(id);\n}\n\nconst eligible = mediaRows.filter(r => {\n  const id = String(r.ID_MIDIA || '').trim();\n  if (!targetIds.has(id)) return false;\n  if (String(r.STORAGE_STATUS || '').trim().toUpperCase() !== 'ONLINE') return false;\n\n  const missing =\n    !String(r.CONTENT_HASH || '').trim() ||\n    !String(r.MIME_TYPE || '').trim() ||\n    !String(r.TECHNICAL_METADATA_JSON || '').trim();\n\n  return missing;\n});\n\nif (eligible.length === 0) {\n  return [{\n    json:{\n      queue_empty:true,\n      analysis_route:'NO_WORK',\n      target_media_ids:[...targetIds],\n      queued_at:new Date().toISOString()\n    }\n  }];\n}\n\nreturn eligible.map(r => {\n  const type = String(r.TIPO || '').trim().toUpperCase();\n  const route =\n    type === 'FOTO' ? 'IMAGE_ORIGINAL' :\n    type === 'VÍDEO' || type === 'VIDEO' ? 'VIDEO_PROXY' :\n    'UNSUPPORTED';\n\n  return {\n    json:{\n      ...r,\n      queue_empty:false,\n      analysis_route:route,\n      metadata_backfill:true,\n      queued_at:new Date().toISOString()\n    }\n  };\n});"
      },
