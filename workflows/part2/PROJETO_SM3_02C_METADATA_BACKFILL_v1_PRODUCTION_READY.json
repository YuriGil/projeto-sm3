      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\n\nreturn items.map(w => {\n  const m = w.metadata || {};\n  if (!w.media_id) throw new Error('METADATA_BACKFILL_BLOCK: missing media_id');\n  if (!w.content_hash && !m.sha256) throw new Error(`METADATA_BACKFILL_BLOCK: missing hash for ${w.media_id}`);\n\n  return {json:{\n    ID_MIDIA:w.media_id,\n    DATA_CAPTURA:String(m.captured_at || ''),\n    MIME_TYPE:String(m.mime_type || ''),\n    FILE_SIZE_BYTES:Number(m.bytes || 0) || '',\n    CONTENT_HASH:String(w.content_hash || m.sha256 || ''),\n    CAPTURED_AT_SOURCE:String(m.captured_at_source || ''),\n    TECHNICAL_METADATA_JSON:JSON.stringify(m || {}),\n    PROXY_STATUS:'LOCAL_READY'\n  }};\n});"
      },
