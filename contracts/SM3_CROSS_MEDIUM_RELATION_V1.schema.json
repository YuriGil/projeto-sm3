{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SM3_CROSS_MEDIUM_RELATION_V1",
  "title": "SM3 Cross Medium Relation V1",
  "type": "object",
  "required": [
    "contract_version",
    "relation",
    "from_asset_id",
    "to_asset_id",
    "confidence",
    "evidence"
  ],
  "properties": {
    "contract_version": {
      "const": "SM3_CROSS_MEDIUM_RELATION_V1"
    },
    "relation": {
      "enum": [
        "SAME_ARTWORK",
        "DERIVED_FROM",
        "TRANSLATED_TO_STENCIL",
        "EXECUTED_ON_SKIN",
        "FINAL_STATE_OF"
      ]
    },
    "from_asset_id": {
      "type": "string"
    },
    "to_asset_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
