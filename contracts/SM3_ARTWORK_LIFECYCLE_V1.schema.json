{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SM3_ARTWORK_LIFECYCLE_V1",
  "title": "SM3 Artwork Lifecycle V1",
  "type": "object",
  "required": [
    "contract_version",
    "artwork_id",
    "phases"
  ],
  "properties": {
    "contract_version": {
      "const": "SM3_ARTWORK_LIFECYCLE_V1"
    },
    "artwork_id": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "status"
        ],
        "properties": {
          "phase": {
            "enum": [
              "DRAWING_CREATION",
              "STENCIL_TRANSLATION",
              "TATTOO_EXECUTION",
              "FINAL"
            ]
          },
          "status": {
            "enum": [
              "EVIDENCED",
              "PARTIAL",
              "UNKNOWN"
            ]
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
