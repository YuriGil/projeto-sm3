{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SM3_MATERIAL_MEDIUM_V1",
  "title": "SM3 Material Medium V1",
  "type": "object",
  "required": [
    "contract_version",
    "medium",
    "tool",
    "confidence",
    "evidence"
  ],
  "properties": {
    "contract_version": {
      "const": "SM3_MATERIAL_MEDIUM_V1"
    },
    "medium": {
      "enum": [
        "PAPER",
        "SKIN",
        "TRANSFER_PAPER",
        "DIGITAL",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "tool": {
      "enum": [
        "PENCIL",
        "GRAPHITE",
        "FINELINER",
        "INK_PEN",
        "BRUSH",
        "ERASER",
        "MARKER",
        "TATTOO_MACHINE",
        "STENCIL_TRANSFER",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
