{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"SM3_PUBLICATION_ARTIFACT_V1",
  "title":"SM3 Publication Artifact V1",
  "type":"object",
  "required":["ok","artifact_id","contract_version","renderer_version","editorial_plan_id","editorial_plan_sha256","project_id","content_id","edit_session_id","revision","state_etag","artifact_type","assets","review_asset","manifest_sha256"],
  "properties":{
    "ok":{"const":true},
    "artifact_id":{"type":"string","pattern":"^PA_[a-f0-9]{32}$"},
    "contract_version":{"const":"SM3_PUBLICATION_ARTIFACT_V1"},
    "renderer_version":{"const":"2.13.0"},
    "editorial_plan_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "artifact_type":{"enum":["CAROUSEL_IMAGE_SET","SINGLE_IMAGE"]},
    "assets":{"type":"array","minItems":1,"items":{"type":"object","required":["asset_id","media_id","sha256","bytes","width","height"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":1000},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}},"additionalProperties":true}},
    "review_artifact_separate_from_native_product":{"const":true},
    "no_timeline_for_carousel":{"const":true},
    "no_generic_footer":{"const":true},
    "no_redundant_stage_labels":{"const":true},
    "auto_publish_allowed":{"const":false},
    "human_approval_required":{"const":true},
    "manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":true
}
