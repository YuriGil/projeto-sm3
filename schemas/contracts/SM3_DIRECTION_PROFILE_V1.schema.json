{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SM3_DIRECTION_PROFILE_V1",
  "title": "SM3 Direction Profile V1",
  "type": "object",
  "required": [
    "profile_id",
    "name",
    "family",
    "profile_version",
    "description",
    "resolved_intent",
    "foundation_invariants",
    "profile_sha256",
    "resolved_profile_sha256"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^DP_[A-Z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "parent_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "parent_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_intent": {
      "type": "object"
    },
    "foundation_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resolved_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}