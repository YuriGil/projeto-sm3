{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SM3_PLATFORM_CAPABILITY_MODEL_V1",
  "title": "SM3 Platform Capability Model V1",
  "type": "object",
  "required": [
    "contract_version",
    "platform_id",
    "observed_at",
    "capabilities",
    "evidence_refs",
    "confidence"
  ],
  "properties": {
    "contract_version": {
      "const": "SM3_PLATFORM_CAPABILITY_MODEL_V1"
    },
    "platform_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "surface_models": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
